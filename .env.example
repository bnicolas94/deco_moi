# WhatsApp (datos publicos)
PUBLIC_WHATSAPP_NUMBER=""
PUBLIC_WHATSAPP_MESSAGE="Hola! Tengo una consulta sobre..."

# Analytics (identificadores publicos)
PUBLIC_GA_ID=""
PUBLIC_FB_PIXEL_ID=""

# Admin: generar un valor aleatorio de al menos 32 bytes
