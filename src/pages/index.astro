---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getHomeBlocks } from '@/lib/services/HomeService';

// Importar componentes de bloques
import HeroBlock from '../components/home/HeroBlock.astro';
import CategoriesBlock from '../components/home/CategoriesBlock.astro';
import FeaturedProductsBlock from '../components/home/FeaturedProductsBlock.astro';
import TestimonialsBlock from '../components/home/TestimonialsBlock.astro';
import CTABlock from '../components/home/CTABlock.astro';

const blocks = await getHomeBlocks();

// Mapeo de tipos de bloques a componentes
const blockComponents: Record<string, any> = {
  hero: HeroBlock,
  categories: CategoriesBlock,
  featured_products: FeaturedProductsBlock,
  testimonials: TestimonialsBlock,
  cta: CTABlock,
};
---

<BaseLayout>
  {blocks.length > 0 ? (
    blocks.map((block) => {
      const Component = blockComponents[block.type];
      return Component ? <Component {...block.settings} /> : null;
    })
  ) : (
    /* Fallback en caso de que no haya bloques (aunque el seed debería haber funcionado) */
    <div class="py-20 text-center">
      <h1 class="text-2xl font-bold">Bienvenido a Deco Moi</h1>
      <p class="text-gray-500 mt-2">Estamos configurando el contenido. Volvé pronto!</p>
      <a href="/admin/settings/home" class="btn btn-primary mt-4">Configurar Home</a>
    </div>
  )}
</BaseLayout>
