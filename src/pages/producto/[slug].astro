---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ProductGrid from "../../components/product/ProductGrid.astro";
import PriceTable from "../../components/product/PriceTable.astro";
import {
  getProductBySlug,
  getRelatedProducts,
  getProductReviews,
} from "@/lib/services/ProductService";
import { formatPrice } from "@/lib/utils/formatters";

import { MockupGenerator } from "@/components/mockup/MockupGenerator";

const { slug } = Astro.params;
if (!slug) return Astro.redirect("/productos");

const product = await getProductBySlug(slug);
if (!product) return Astro.redirect("/productos");
console.log(
  "RENDER PRODUCT SHORT DESCRIPTION:",
  JSON.stringify(product.shortDescription),
);

const relatedProducts = await getRelatedProducts(
  product.id,
  product.categoryId,
  4,
);
const productReviews = await getProductReviews(product.id);

const basePrice = Number(product.basePrice);
const finalPrice =
  product.isOnSale && product.salePrice ? Number(product.salePrice) : basePrice;
const transferPrice = finalPrice * 0.9;
const discountPct =
  product.isOnSale && product.salePrice
    ? Math.round(((basePrice - Number(product.salePrice)) / basePrice) * 100)
    : 0;

const specs = product.specifications as Record<string, string> | null;
const customization = product.customizationOptions as {
  allowsPersonalization?: boolean;
  fields?: string[];
} | null;
const priceRules = (product as any).priceRules || [];
const variantGroups = (product as any).variantGroups || [];
const productionTimeRules = (product as any).productionTimeRules || [];
const category = (product as any).category;
const images = product.images || [];
const avgRating =
  productReviews.length > 0
    ? (
        productReviews.reduce((sum: number, r: any) => sum + r.rating, 0) /
        productReviews.length
      ).toFixed(1)
    : null;

// Compute initial production time
const initialQty = product.minOrder || 1;
const initialProductionTime =
  productionTimeRules.length > 0
    ? productionTimeRules.find(
        (r: any) =>
          initialQty >= r.minQuantity &&
          (r.maxQuantity === null || initialQty <= r.maxQuantity),
      )?.productionTime ||
      product.productionTime ||
      "A consultar"
    : product.productionTime || null;
---

<BaseLayout
  title={`${product.name} — Deco Moi`}
  description={product.shortDescription || `Comprá ${product.name} en Deco Moi`}
>
  <!-- Breadcrumb -->
  <div class="bg-white border-b border-gray-100">
    <div class="container py-3">
      <nav
        class="flex items-center gap-2 text-sm text-gray-400 flex-wrap"
        aria-label="Breadcrumb"
      >
        <a href="/" class="hover:text-brand-black transition-colors">Inicio</a>
        <svg
          class="w-4 h-4"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M9 5l7 7-7 7"></path>
        </svg>
        <a href="/productos" class="hover:text-brand-black transition-colors"
          >Productos</a
        >
        {
          category && (
            <>
              <svg
                class="w-4 h-4"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M9 5l7 7-7 7"
                />
              </svg>
              <a
                href={`/productos/${category.slug}`}
                class="hover:text-brand-black transition-colors"
              >
                {category.name}
              </a>
            </>
          )
        }
        <svg
          class="w-4 h-4"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M9 5l7 7-7 7"></path>
        </svg>
        <span class="text-brand-black font-medium">{product.name}</span>
      </nav>
    </div>
  </div>

  <div class="container py-4 md:py-8">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 lg:gap-10">
      <!-- Galería de imágenes -->
      <div>
        <div
          class="relative aspect-square rounded-2xl overflow-hidden bg-light-gray mb-4"
        >
          {
            images.length > 0 ? (
              <img
                id="main-image"
                src={images[0]}
                alt={product.name}
                class="w-full h-full object-cover"
              />
            ) : (
              <div
                id="main-image-placeholder"
                class="absolute inset-0 flex items-center justify-center"
              >
                <div class="text-center p-8">
                  <svg
                    class="w-20 h-20 mx-auto text-gray-300 mb-3"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="1.5"
                      d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"
                    />
                  </svg>
                  <p class="text-sm text-gray-400">Imagen próximamente</p>
                </div>
              </div>
            )
          }

          {/* Badges */}
          <div class="absolute top-4 left-4 flex flex-col gap-2">
            {
              product.isOnSale && (
                <span class="badge badge-sale">-{discountPct}% OFF</span>
              )
            }
            {
              product.isFeatured && (
                <span class="badge badge-featured">⭐ Destacado</span>
              )
            }
          </div>
        </div>

        {/* Thumbnails */}
        <div id="product-thumbnails" class="flex gap-3 overflow-x-auto pb-2">
          {
            images.length > 1 &&
              images.map((img: string, i: number) => (
                <button
                  class:list={[
                    "product-thumb w-20 h-20 rounded-lg overflow-hidden flex-shrink-0 border-2 transition-all",
                    i === 0
                      ? "border-primary"
                      : "border-transparent hover:border-primary/50",
                  ]}
                  data-src={img}
                >
                  <img
                    src={img}
                    alt={`${product.name} ${i + 1}`}
                    class="w-full h-full object-cover"
                  />
                </button>
              ))
          }
        </div>
      </div>

      <!-- Info del producto -->
      <div>
        <div class="mb-4">
          {
            category && (
              <a
                href={`/productos/${category.slug}`}
                class="text-xs text-accent font-heading font-medium uppercase tracking-wider hover:text-secondary transition-colors"
              >
                {category.name}
              </a>
            )
          }
          <h1
            class="text-3xl md:text-4xl font-heading font-light text-brand-black mt-1 mb-1"
          >
            {product.name}
          </h1>

          {/* Rating */}
          {
            avgRating && (
              <div class="flex items-center gap-2 mb-2">
                <div class="flex items-center gap-0.5">
                  {[1, 2, 3, 4, 5].map((star) => (
                    <svg
                      class:list={[
                        "w-4 h-4",
                        star <= Math.round(Number(avgRating))
                          ? "text-gold"
                          : "text-gray-200",
                      ]}
                      fill="currentColor"
                      viewBox="0 0 24 24"
                    >
                      <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z" />
                    </svg>
                  ))}
                </div>
                <span class="text-sm text-gray-400">
                  ({avgRating}) · {productReviews.length}{" "}
                  {productReviews.length === 1 ? "reseña" : "reseñas"}
                </span>
              </div>
            )
          }

          {
            product.sku && (
              <p class="text-xs text-gray-400">SKU: {product.sku}</p>
            )
          }
        </div>

        <!-- Precios -->
        <div class="mb-4">
          <div class="flex items-baseline gap-2 mb-1">
            {
              product.isOnSale && product.salePrice ? (
                <>
                  <span id="main-original-price-display" class="price-original text-lg">
                    {formatPrice(basePrice)}
                  </span>
                  <span id="main-price-display" class="text-2xl font-semibold text-brand-black">
                    {formatPrice(finalPrice)}
                  </span>
                  <span class="badge badge-sale">-{discountPct}%</span>
                </>
              ) : (
                <span id="main-price-display" class="text-2xl font-semibold text-brand-black">
                  {formatPrice(finalPrice)}
                </span>
              )
            }
          </div>
          <p id="main-transfer-price-display" class="text-sm text-gray-500 font-medium">
            {formatPrice(transferPrice)} con transferencia
          </p>
        </div>

        <hr class="my-6 border-gray-200" />



        <!-- Grupos de Opciones Multi-dimensionales -->
        {
          variantGroups && variantGroups.length > 0 && (
            <div class="mb-5 space-y-4" id="variant-groups-container">
              {variantGroups.map((group: any) => (
                <div class="variant-group" data-group-id={group.id} data-group-name={group.name} data-is-required={group.isRequired ? 'true' : 'false'}>
                  <div class="flex items-center justify-between mb-2">
                    <h3 class="text-sm text-dark-gray">
                      {group.name} {group.isRequired && <span class="text-rose-500">*</span>}
                    </h3>
                    <span class="text-xs text-gray-400 group-selection-status">
                      {group.isRequired ? 'Requerido' : 'Opcional'}
                    </span>
                  </div>
                  <div class="flex flex-wrap gap-2">
                    {group.options.filter((o: any) => o.isActive).map((opt: any) => (
                      <button
                        type="button"
                        class:list={[
                          "group-opt-btn relative flex items-center justify-center px-4 py-2 rounded-lg border transition-all duration-300 overflow-hidden border-gray-200 bg-white text-gray-500 hover:border-gray-400 hover:bg-gray-50",
                        ]}
                        data-option-id={opt.id}
                        data-option-name={opt.name}
                        data-option-sku={opt.sku || ""}
                        data-price-modifier={opt.priceModifier}
                        data-option-stock={opt.stock}
                        data-option-images={JSON.stringify(opt.images || [])}
                      >
                        {(opt.images && opt.images.length > 0) && (
                          <img src={opt.images[0]} alt={opt.name} class="w-6 h-6 rounded-full mr-2 object-cover border border-gray-100" />
                        )}
                        <span class="text-sm font-medium transition-colors">
                          {opt.name}
                        </span>
                        {Number(opt.stock) <= 0 && (
                          <span class="absolute top-0 right-0 text-[8px] uppercase tracking-tighter text-gray-400 font-bold bg-white px-1">
                            x
                          </span>
                        )}
                        {Number(opt.priceModifier) > 0 && (
                          <span class="ml-1.5 text-[10px] text-gray-400 font-bold bg-gray-100 px-1.5 py-0.5 rounded">
                            +{formatPrice(Number(opt.priceModifier))}
                          </span>
                        )}
                        <div class="absolute inset-0 bg-transparent opacity-0 pointer-events-none hidden indicator" />
                      </button>
                    ))}
                  </div>
                </div>
              ))}
            </div>
          )
        }

        {/* Descripción corta */}
        {
          product.shortDescription && (
            <div
              class="rich-text-content text-gray-500 mb-6 leading-relaxed prose prose-sm max-w-none"
              set:html={product.shortDescription}
            />
          )
        }

        <hr class="my-6 border-gray-200" />

        <div class="flex flex-col gap-6 mb-6">
          <div class="flex-none">
            <!-- Selector cantidad -->
            <div class="mb-4">
              <p class="text-sm text-dark-gray mb-1">Cantidad:</p>
              <div
                class="inline-flex items-center border border-gray-200 rounded-xl overflow-hidden bg-white shadow-sm"
              >
                <button
                  id="qty-minus"
                  class="w-10 h-10 flex items-center justify-center text-dark-gray hover:bg-gray-50 transition-colors"
                  aria-label="Disminuir cantidad"
                >
                  <svg
                    class="w-4 h-4"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M20 12H4"></path>
                  </svg>
                </button>
                <input
                  id="qty-input"
                  type="number"
                  value={product.minOrder || 1}
                  min={product.minOrder || 1}
                  class="w-12 h-10 text-center text-sm font-semibold border-x border-gray-200 outline-none"
                />
                <button
                  id="qty-plus"
                  class="w-10 h-10 flex items-center justify-center text-dark-gray hover:bg-gray-50 transition-colors"
                  aria-label="Aumentar cantidad"
                >
                  <svg
                    class="w-4 h-4"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M12 6v12m6-6H6"></path>
                  </svg>
                </button>
              </div>
            </div>

            <!-- Total Estimado -->
            <div
              class="bg-off-white rounded-xl p-4"
              id="estimated-total-container"
            >
              <p
                class="text-[10px] text-gray-500 font-heading font-semibold uppercase tracking-wider mb-0.5"
              >
                Total Estimado
              </p>
              <div class="flex items-baseline gap-2 mb-0.5">
                <span
                  id="estimated-total-price"
                  class="text-2xl font-bold text-brand-black">$0</span
                >
              </div>
              <p
                id="estimated-total-transfer"
                class="text-xs text-gray-400 mb-1"
              >
                $0 con transferencia
              </p>
              <div
                id="volume-discount-message"
                class="text-xs text-[#009688] font-medium flex items-center gap-1 hidden mt-1"
              >
                <span>🎉</span>
                <span
                  >Descuento por cantidad aplicado: +<strong
                    id="volume-discount-qty"></strong> unidades.</span
                >
              </div>
            </div>
          </div>

          <div class="flex-1 md:pb-1">
          <!-- Botones de Acción -->
          <div class="grid grid-cols-2 gap-2 sm:gap-3">
            <button
              id="buy-now-btn"
              class="btn btn-primary w-full text-xs sm:text-base disabled:opacity-50 disabled:cursor-not-allowed"
              data-product-id={product.id}
              data-product-name={product.name}
              data-product-slug={product.slug}
              data-product-sku={product.sku}
              data-product-price={finalPrice}
              data-product-baseprice={finalPrice}
              data-product-pricerules={JSON.stringify(priceRules)}
              data-product-image={images[0] || ""}
              disabled={product.variants && product.variants.length > 0}
            >
              {
                product.variants && product.variants.length > 0
                  ? "Seleccionar opción"
                  : "Comprar ahora"
              }
            </button>

            <button
              id="add-to-cart-main"
              class="btn btn-outline w-full text-xs sm:text-base disabled:opacity-50 disabled:cursor-not-allowed"
              data-product-id={product.id}
              data-product-name={product.name}
              data-product-slug={product.slug}
              data-product-sku={product.sku}
              data-product-price={finalPrice}
              data-product-baseprice={finalPrice}
              data-product-pricerules={JSON.stringify(priceRules)}
              data-product-image={images[0] || ""}
              disabled={product.variants && product.variants.length > 0}
            >
              {
                product.variants && product.variants.length > 0
                  ? "Seleccionar opción"
                  : "Agregar al carrito"
              }
            </button>
          </div>
        </div>
      </div>

      <!-- Personalización -->
      {
        customization?.allowsPersonalization && (
          <div class="p-4 rounded-xl border border-primary/30 bg-primary/5 mb-6">
            <h3 class="font-heading font-semibold text-sm text-brand-black mb-2 flex items-center gap-2">
              <svg
                class="w-5 h-5 text-accent"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"
                />
              </svg>
              Producto personalizable
            </h3>
            <p class="text-sm text-dark-gray mb-2">
              Este producto se puede personalizar con:
            </p>
            <div class="flex flex-wrap gap-2">
              {customization.fields?.map((field: string) => (
                <span class="px-3 py-1 rounded-full bg-white text-xs text-dark-gray border border-gray-200 capitalize">
                  {field.replace("_", " ")}
                </span>
              ))}
            </div>
          </div>
        )
      }

      {/* Tiempo de producción */}
      {
        initialProductionTime && (
          <div
            class="flex items-center gap-2 mb-6 p-3 bg-amber-50 rounded-xl border border-amber-100"
            id="production-time-container"
          >
            <svg
              class="w-5 h-5 text-amber-600 flex-shrink-0"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"
              />
            </svg>
            <span class="text-sm text-amber-800 font-medium">
              Tiempo de producción:{" "}
              <strong id="production-time-display">
                {initialProductionTime}
              </strong>
            </span>
          </div>
        )
      }
    </div>
  </div>

  <!-- Generador de Mockups -->
  {
    product.mockupTemplate && (
      <div class="mt-12 mb-12">
        <MockupGenerator
          client:only="react"
          mode="client"
          template={product.mockupTemplate}
          productName={product.name}
        />
      </div>
    )
  }

  </div> <!-- Cierra el container superior -->

  <!-- Tabs: Descripción / Precios / Especificaciones / Reseñas -->
  <div class="w-full bg-white border-y border-gray-100 py-12 md:py-16 mt-8 shadow-[0_4px_30px_rgba(0,0,0,0.02)]">
    <div class="container">
      <div>
        <div
          class="flex gap-1 overflow-x-auto pb-1 mb-6 border-b border-gray-100"
      role="tablist"
    >
      <button
        class="tab-btn active px-5 py-3 text-sm font-heading font-medium text-brand-black border-b-2 border-primary whitespace-nowrap transition-colors"
        data-tab="descripcion"
      >
        Descripción
      </button>
      {
        product.showDiscountRanges && priceRules.length > 0 && (
          <button
            class="tab-btn px-5 py-3 text-sm font-heading font-medium text-gray-400 border-b-2 border-transparent hover:text-brand-black whitespace-nowrap transition-colors"
            data-tab="precios"
          >
            Precios por cantidad
          </button>
        )
      }
      {
        specs && Object.keys(specs).length > 0 && (
          <button
            class="tab-btn px-5 py-3 text-sm font-heading font-medium text-gray-400 border-b-2 border-transparent hover:text-brand-black whitespace-nowrap transition-colors"
            data-tab="especificaciones"
          >
            Especificaciones
          </button>
        )
      }
      {
        productReviews.length > 0 && (
          <button
            class="tab-btn px-5 py-3 text-sm font-heading font-medium text-gray-400 border-b-2 border-transparent hover:text-brand-black whitespace-nowrap transition-colors"
            data-tab="resenas"
          >
            Reseñas ({productReviews.length})
          </button>
        )
      }
    </div>

    <!-- Tab: Descripción -->
    <div class="tab-content" data-tab-content="descripcion">
      <div
        class="rich-text-content prose prose-sm max-w-none"
        set:html={product.description}
      />
    </div>

    <!-- Tab: Precios -->
    {
      product.showDiscountRanges && priceRules.length > 0 && (
        <div class="tab-content hidden" data-tab-content="precios">
          <div class="max-w-2xl">
            <h3 class="font-heading font-semibold text-lg text-brand-black mb-4">
              Precios por cantidad
            </h3>
            <p class="text-sm text-gray-500 mb-4">
              Aprovechá nuestros descuentos por cantidad. Cuanto más pedís, más
              ahorrás.
            </p>
            <PriceTable basePrice={basePrice} priceRules={priceRules} />
          </div>
        </div>
      )
    }

    <!-- Tab: Especificaciones -->
    {
      specs && Object.keys(specs).length > 0 && (
        <div class="tab-content hidden" data-tab-content="especificaciones">
          <div class="max-w-xl">
            <dl class="divide-y divide-gray-100">
              {Object.entries(specs).map(([key, value]) => (
                <div class="flex items-center justify-between py-3">
                  <dt class="text-sm text-gray-500">{key}</dt>
                  <dd class="text-sm font-medium text-brand-black">{value}</dd>
                </div>
              ))}
            </dl>
          </div>
        </div>
      )
    }

    <!-- Tab: Reseñas -->
    {
      productReviews.length > 0 && (
        <div class="tab-content hidden" data-tab-content="resenas">
          <div class="max-w-2xl">
            {/* Rating promedio */}
            <div class="flex items-center gap-4 mb-8 p-4 rounded-xl bg-off-white">
              <div class="text-center">
                <p class="text-4xl font-heading font-bold text-brand-black">
                  {avgRating}
                </p>
                <div class="flex items-center gap-0.5 mt-1">
                  {[1, 2, 3, 4, 5].map((star) => (
                    <svg
                      class:list={[
                        "w-4 h-4",
                        star <= Math.round(Number(avgRating))
                          ? "text-gold"
                          : "text-gray-200",
                      ]}
                      fill="currentColor"
                      viewBox="0 0 24 24"
                    >
                      <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z" />
                    </svg>
                  ))}
                </div>
                <p class="text-xs text-gray-400 mt-1">
                  {productReviews.length} reseñas
                </p>
              </div>
            </div>

            {/* Lista de reseñas */}
            <div class="space-y-6">
              {productReviews.map((review: any) => (
                <div class="border-b border-gray-100 pb-6">
                  <div class="flex items-center gap-3 mb-2">
                    <div class="w-8 h-8 rounded-full bg-primary/30 flex items-center justify-center">
                      <span class="text-xs font-bold text-secondary">
                        {review.authorName
                          .split(" ")
                          .map((w: string) => w[0])
                          .join("")
                          .slice(0, 2)}
                      </span>
                    </div>
                    <div>
                      <p class="text-sm font-heading font-semibold text-brand-black">
                        {review.authorName}
                      </p>
                      <div class="flex items-center gap-1">
                        {[1, 2, 3, 4, 5].map((star) => (
                          <svg
                            class:list={[
                              "w-3 h-3",
                              star <= review.rating
                                ? "text-gold"
                                : "text-gray-200",
                            ]}
                            fill="currentColor"
                            viewBox="0 0 24 24"
                          >
                            <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z" />
                          </svg>
                        ))}
                        {review.isVerified && (
                          <span class="text-2xs text-success ml-1">
                            ✓ Verificada
                          </span>
                        )}
                      </div>
                    </div>
                  </div>
                  <p class="text-sm text-dark-gray leading-relaxed italic">
                    "{review.comment}"
                  </p>
                </div>
              ))}
            </div>
          </div>
        </div>
      )
    }
      </div>
    </div>
  </div>

  <!-- Productos relacionados -->
  <div class="container">
    {
      relatedProducts.length > 0 && (
        <div class="py-12 md:py-16">
          <h2 class="section-title text-left mb-2">También te puede interesar</h2>
          <div class="gold-line-left mb-8" />
          <ProductGrid products={relatedProducts} />
        </div>
      )
    }
  </div>
</BaseLayout>

<style is:global>
  .rich-text-content p {
    margin-bottom: 1rem;
  }
  .rich-text-content strong {
    font-weight: 700;
    color: inherit;
  }
  .rich-text-content em {
    font-style: italic;
  }
  .rich-text-content u {
    text-decoration: underline;
  }
  .rich-text-content ul {
    list-style-type: disc;
    margin-left: 1.5rem;
    margin-bottom: 1rem;
  }
  .rich-text-content ol {
    list-style-type: decimal;
    margin-left: 1.5rem;
    margin-bottom: 1rem;
  }
  .rich-text-content li {
    margin-bottom: 0.25rem;
  }
  .rich-text-content a {
    color: #4f46e5;
    text-decoration: underline;
  }
</style>

<script>
  // Tabs
  document.querySelectorAll(".tab-btn").forEach((btn) => {
    btn.addEventListener("click", () => {
      const tab = btn.getAttribute("data-tab");

      document.querySelectorAll(".tab-btn").forEach((b) => {
        b.classList.remove("active", "text-brand-black", "border-primary");
        b.classList.add("text-gray-400", "border-transparent");
      });
      btn.classList.add("active", "text-brand-black", "border-primary");
      btn.classList.remove("text-gray-400", "border-transparent");

      document
        .querySelectorAll(".tab-content")
        .forEach((c) => c.classList.add("hidden"));
      document
        .querySelector(`[data-tab-content="${tab}"]`)
        ?.classList.remove("hidden");
    });
  });

  // Formato de precio helper
  const formatPrice = (price) => {
    return new Intl.NumberFormat("es-AR", {
      style: "currency",
      currency: "ARS",
      minimumFractionDigits: 0,
    }).format(price);
  };

  // Variantes
  const variantSelector = document.getElementById("variant-selector");
  const mainAddToCartBtn = document.getElementById("add-to-cart-main");
  const buyNowBtn = document.getElementById("buy-now-btn");
  const priceDisplay = document.getElementById("main-price-display");
  const skuDisplay = document.querySelector(".text-xs.text-gray-400:last-of-type");
  const transferPriceDisplay = document.getElementById("main-transfer-price-display");
  const qtyInput = document.getElementById("qty-input") as HTMLInputElement;

  let currentBasePrice = parseFloat(
    mainAddToCartBtn?.getAttribute("data-product-price") || "0",
  );

  function updatePricingDisplays(baseP) {
    const qty = parseInt(qtyInput?.value || "1");
    const rules = (window as any).__priceRules || [];

    let appliedDiscountPct = 0;
    let appliedDiscountRule = null;
    if (rules.length > 0) {
      const applicableRule = rules
        .filter(
          (r: any) =>
            qty >= r.minQuantity &&
            (r.maxQuantity === null || qty <= r.maxQuantity),
        )
        .sort((a: any, b: any) => b.minQuantity - a.minQuantity)[0];
      if (applicableRule) {
        appliedDiscountPct = parseFloat(applicableRule.discountPercentage);
        appliedDiscountRule = applicableRule;
      }
    }

    const unitPrice = baseP * (1 - appliedDiscountPct / 100);

    if (mainAddToCartBtn) {
      mainAddToCartBtn.setAttribute("data-product-price", unitPrice.toString());
      mainAddToCartBtn.setAttribute("data-product-baseprice", baseP.toString());
    }
    if (buyNowBtn) {
      buyNowBtn.setAttribute("data-product-price", unitPrice.toString());
      buyNowBtn.setAttribute("data-product-baseprice", baseP.toString());
    }

    if (priceDisplay) {
      if (appliedDiscountPct > 0) {
        priceDisplay.innerHTML = `<span class="line-through text-gray-400 text-xl mr-2">${formatPrice(baseP)}</span>${formatPrice(unitPrice)}`;
      } else {
        priceDisplay.textContent = formatPrice(baseP);
      }
    }

    if (transferPriceDisplay) {
      const transferPrice = unitPrice * 0.9;
      transferPriceDisplay.textContent = `${formatPrice(transferPrice)} con transferencia`;
    }

    // Update Estimated Total
    const estimatedTotalContainer = document.getElementById(
      "estimated-total-container",
    );
    if (estimatedTotalContainer) {
      const totalPrice = unitPrice * qty;
      const totalTransfer = totalPrice * 0.9;

      const totalPriceDisplay = document.getElementById(
        "estimated-total-price",
      );
      if (totalPriceDisplay) {
        totalPriceDisplay.textContent = formatPrice(totalPrice);
      }

      const totalTransferDisplay = document.getElementById(
        "estimated-total-transfer",
      );
      if (totalTransferDisplay) {
        totalTransferDisplay.textContent = `${formatPrice(totalTransfer)} con transferencia`;
      }

      const volumeDiscountMsg = document.getElementById(
        "volume-discount-message",
      );
      const qtyDisplay = document.getElementById("volume-discount-qty");

      if (
        appliedDiscountPct > 0 &&
        volumeDiscountMsg &&
        qtyDisplay &&
        appliedDiscountRule
      ) {
        qtyDisplay.textContent = appliedDiscountRule.minQuantity.toString();
        volumeDiscountMsg.classList.remove("hidden");
      } else if (volumeDiscountMsg) {
        volumeDiscountMsg.classList.add("hidden");
      }
    }
  }

  variantSelector?.addEventListener("click", (e) => {
    const btn = e.target.closest("button");
    if (!btn || !btn.classList.contains("variant-btn")) return;

    const isSelected = btn.classList.contains("border-brand-black");
    const labelDisplay = document.getElementById("selected-variant-label");
    const mainImage = document.getElementById("main-image") as HTMLImageElement;
    const placeholder = document.getElementById("main-image-placeholder");
    const thumbnailsContainer = document.getElementById("product-thumbnails");

    // Resetear estilos de todos los botones
    variantSelector.querySelectorAll(".variant-btn").forEach((b) => {
      b.classList.remove(
        "border-brand-black",
        "shadow-md",
        "ring-1",
        "ring-brand-black/5",
        "bg-primary/5",
      );
      b.classList.add("border-gray-100", "text-gray-400");
      // Selection indicator
      const indicator = b.querySelector(".absolute");
      if (indicator) {
        indicator.classList.remove(
          "bg-brand-black",
          "scale-100",
          "opacity-100",
        );
        indicator.classList.add("bg-gray-100", "scale-50", "opacity-0");
      }
    });

    if (isSelected) {
      // DESELECCIONAR
      if (labelDisplay) labelDisplay.textContent = "Seleccionar opción";
      currentBasePrice = (window as any).__productBasePrice || currentBasePrice;
      const originalSku = (window as any).__productSku || "";
      const originalImages = (window as any).__productImages || [];

      // Restore Main Image
      if (originalImages.length > 0 && mainImage) {
        mainImage.src = originalImages[0];
      }

      // Restore Thumbnails
      if (thumbnailsContainer && originalImages.length > 1) {
        thumbnailsContainer.innerHTML = originalImages
          .map(
            (img: string, i: number) => `
          <button
            class="product-thumb w-20 h-20 rounded-lg overflow-hidden flex-shrink-0 border-2 transition-all ${i === 0 ? "border-primary" : "border-transparent hover:border-primary/50"}"
            data-src="${img}"
          >
            <img src="${img}" alt="Original ${i + 1}" class="w-full h-full object-cover" />
          </button>
        `,
          )
          .join("");
        attachThumbnailListeners();
      } else if (thumbnailsContainer) {
        thumbnailsContainer.innerHTML = "";
      }

      if (mainAddToCartBtn) {
        mainAddToCartBtn.removeAttribute("data-variant-id");
        mainAddToCartBtn.removeAttribute("data-variant-name");
        mainAddToCartBtn.setAttribute("data-product-sku", originalSku);
        mainAddToCartBtn.setAttribute("disabled", "true");
        mainAddToCartBtn.textContent = "Seleccionar opción";
      }

      if (buyNowBtn) {
        buyNowBtn.setAttribute("data-product-sku", originalSku);
        buyNowBtn.setAttribute("disabled", "true");
        buyNowBtn.textContent = "Seleccionar opción";
      }

      if (skuDisplay && originalSku)
        skuDisplay.textContent = `SKU: ${originalSku}`;

      if (typeof updateVariantGroupsState === 'function') {
        updateVariantGroupsState();
      } else {
        updatePricingDisplays(currentBasePrice);
      }
      return;
    }

    // Resetear estilos de todos los botones
    variantSelector.querySelectorAll(".variant-btn").forEach((b) => {
      b.classList.remove(
        "border-brand-black",
        "shadow-md",
        "ring-1",
        "ring-brand-black/5",
        "bg-brand-black",
        "text-white",
      );
      b.classList.add("border-gray-200", "text-gray-500", "bg-white");
    });

    // Aplicar estilos al seleccionado
    btn.classList.remove("border-gray-200", "text-gray-500", "bg-white");
    btn.classList.add(
      "border-brand-black",
      "shadow-md",
      "ring-1",
      "ring-brand-black/5",
      "bg-brand-black",
      "text-white",
    );

    // Label arriba
    if (labelDisplay)
      labelDisplay.textContent = btn.getAttribute("data-variant-name");

    // Obtener datos de variante
    const variantId = btn.getAttribute("data-variant-id");
    const variantName = btn.getAttribute("data-variant-name");
    const variantSku = btn.getAttribute("data-variant-sku");
    const variantPrice = parseFloat(
      btn.getAttribute("data-variant-price") || "0",
    );
    const variantStock = parseInt(
      btn.getAttribute("data-variant-stock") || "0",
    );
    const variantImagesStr = btn.getAttribute("data-variant-images");
    const variantImages = variantImagesStr ? JSON.parse(variantImagesStr) : [];

    currentBasePrice = variantPrice;

    if (variantImages && variantImages.length > 0) {
      // Update Main Image
      if (mainImage) {
        mainImage.src = variantImages[0];
      } else if (placeholder) {
        const img = document.createElement("img");
        img.id = "main-image";
        img.src = variantImages[0];
        img.alt = variantName || "Variante";
        img.className = "w-full h-full object-cover";
        placeholder.replaceWith(img);
      }

      // Rebuild Thumbnails
      if (thumbnailsContainer) {
        if (variantImages.length > 1) {
          thumbnailsContainer.innerHTML = variantImages
            .map(
              (img, i) => `
            <button
              class="product-thumb w-20 h-20 rounded-lg overflow-hidden flex-shrink-0 border-2 transition-all ${i === 0 ? "border-primary" : "border-transparent hover:border-primary/50"}"
              data-src="${img}"
            >
              <img src="${img}" alt="${variantName} ${i + 1}" class="w-full h-full object-cover" />
            </button>
          `,
            )
            .join("");

          // Re-attach thumbnail listeners
          attachThumbnailListeners();
        } else {
          thumbnailsContainer.innerHTML = "";
        }
      }
    }

    // Actualizar atributos del botón de carrito
    if (mainAddToCartBtn) {
      mainAddToCartBtn.setAttribute("data-variant-id", variantId || "");
      mainAddToCartBtn.setAttribute("data-variant-name", variantName || "");
      mainAddToCartBtn.setAttribute("data-product-sku", variantSku || "");

      // Stock check
      if (variantStock <= 0) {
        mainAddToCartBtn.setAttribute("disabled", "true");
        mainAddToCartBtn.textContent = "Sin stock";
      } else {
        mainAddToCartBtn.removeAttribute("disabled");
        mainAddToCartBtn.innerHTML = "Agregar al carrito";
      }
    }

    // Sincronizar botón Comprar con la variante activa
    if (buyNowBtn) {
      buyNowBtn.setAttribute("data-product-sku", variantSku || "");
      if (variantStock <= 0) {
        buyNowBtn.setAttribute("disabled", "true");
        buyNowBtn.innerHTML = "Sin stock";
      } else {
        buyNowBtn.removeAttribute("disabled");
        buyNowBtn.innerHTML = "Comprar ahora";
      }
    }

    if (skuDisplay && variantSku) skuDisplay.textContent = `SKU: ${variantSku}`;

    if (typeof updateVariantGroupsState === 'function') {
      updateVariantGroupsState();
    } else {
      updatePricingDisplays(currentBasePrice);
    }
  });

  // Variant Groups Logic
  const variantGroupsContainer = document.getElementById("variant-groups-container");
  
  function checkVariantGroupsValidity() {
    if (!variantGroupsContainer) return true;
    let isValid = true;
    const groups = variantGroupsContainer.querySelectorAll(".variant-group");
    groups.forEach(g => {
      if (g.getAttribute("data-is-required") === 'true') {
        const selected = g.querySelector(".group-opt-btn.border-brand-black");
        if (!selected) isValid = false;
      }
    });
    return isValid;
  }

  function checkVariantGroupsStock() {
    if (!variantGroupsContainer) return true;
    let hasStock = true;
    const groups = variantGroupsContainer.querySelectorAll(".variant-group");
    groups.forEach(g => {
      if (g.getAttribute("data-is-required") === 'true') {
        const selected = g.querySelector(".group-opt-btn.border-brand-black");
        if (selected) {
           const stock = parseInt(selected.getAttribute("data-option-stock") || "0");
           if (stock <= 0) hasStock = false;
        }
      }
    });
    return hasStock;
  }

  function getSelectedGroupOptions() {
    if (!variantGroupsContainer) return [];
    const options = [];
    const groups = variantGroupsContainer.querySelectorAll(".variant-group");
    groups.forEach(g => {
      const selected = g.querySelector(".group-opt-btn.border-brand-black");
      if (selected) {
        options.push({
          groupId: parseInt(g.getAttribute("data-group-id")),
          groupName: g.getAttribute("data-group-name"),
          optionId: parseInt(selected.getAttribute("data-option-id")),
          optionName: selected.getAttribute("data-option-name"),
          optionSku: selected.getAttribute("data-option-sku"),
          priceModifier: parseFloat(selected.getAttribute("data-price-modifier") || "0")
        });
      }
    });
    return options;
  }

  function updateVariantGroupsState() {
    const isValid = checkVariantGroupsValidity();
    const hasStock = checkVariantGroupsStock();
    const options = getSelectedGroupOptions();
    
    // Add selectedOptions to buttons
    const optionsStr = JSON.stringify(options);
    if (mainAddToCartBtn) mainAddToCartBtn.setAttribute("data-selected-options", optionsStr);
    if (buyNowBtn) buyNowBtn.setAttribute("data-selected-options", optionsStr);

    // Calc total modifier
    const totalModifier = options.reduce((sum, o) => sum + o.priceModifier, 0);

    // Update pricing displays with base + modifier
    updatePricingDisplays(currentBasePrice + totalModifier);

    // Manage buttons disabled state
    const outOfStock = (mainAddToCartBtn?.getAttribute("data-original-text") === "Sin stock" || mainAddToCartBtn?.textContent === "Sin stock") || !hasStock;

    if (mainAddToCartBtn) {
      if (outOfStock) {
        mainAddToCartBtn.setAttribute("disabled", "true");
        mainAddToCartBtn.textContent = "Sin stock";
      } else if (!isValid) {
        mainAddToCartBtn.setAttribute("disabled", "true");
        mainAddToCartBtn.textContent = "Seleccionar opciones";
      } else {
        mainAddToCartBtn.removeAttribute("disabled");
        mainAddToCartBtn.textContent = "Agregar al carrito";
      }
    }

    if (buyNowBtn) {
      if (outOfStock) {
        buyNowBtn.setAttribute("disabled", "true");
        buyNowBtn.textContent = "Sin stock";
      } else if (!isValid) {
        buyNowBtn.setAttribute("disabled", "true");
        buyNowBtn.textContent = "Seleccionar opciones";
      } else {
        buyNowBtn.removeAttribute("disabled");
        buyNowBtn.textContent = "Comprar ahora";
      }
    }
  }

  variantGroupsContainer?.addEventListener("click", (e) => {
    const btn = e.target.closest(".group-opt-btn");
    if (!btn) return;
    
    const group = btn.closest(".variant-group");
    if (!group) return;

    const isSelected = btn.classList.contains("border-brand-black");
    
    // Deselect all in this group
    group.querySelectorAll(".group-opt-btn").forEach(b => {
      b.classList.remove("border-brand-black", "shadow-md", "ring-1", "ring-brand-black/5", "bg-brand-black", "text-white");
      b.classList.add("border-gray-200", "text-gray-500", "bg-white");
    });

    if (!isSelected) {
      // Select it
      btn.classList.remove("border-gray-200", "text-gray-500", "bg-white");
      btn.classList.add("border-brand-black", "shadow-md", "ring-1", "ring-brand-black/5", "bg-brand-black", "text-white");
      
      // Update Images if option has any
      const optImagesStr = btn.getAttribute("data-option-images");
      const optImages = optImagesStr ? JSON.parse(optImagesStr) : [];
      if (optImages && optImages.length > 0) {
        const mainImage = document.getElementById("main-image");
        const placeholder = document.getElementById("main-image-placeholder");
        const thumbnailsContainer = document.getElementById("product-thumbnails");
        const optName = btn.getAttribute("data-option-name");

        if (mainImage) {
          mainImage.src = optImages[0];
        } else if (placeholder) {
          const img = document.createElement("img");
          img.id = "main-image";
          img.src = optImages[0];
          img.alt = optName || "Opción";
          img.className = "w-full h-full object-cover";
          placeholder.replaceWith(img);
        }

        if (thumbnailsContainer) {
          if (optImages.length > 1) {
            thumbnailsContainer.innerHTML = optImages
              .map(
                (img, i) => `
              <button
                class="product-thumb w-20 h-20 rounded-lg overflow-hidden flex-shrink-0 border-2 transition-all ${i === 0 ? "border-primary" : "border-transparent hover:border-primary/50"}"
                data-src="${img}"
              >
                <img src="${img}" alt="${optName} ${i + 1}" class="w-full h-full object-cover" />
              </button>
            `,
              )
              .join("");
            attachThumbnailListeners();
          } else {
            thumbnailsContainer.innerHTML = "";
          }
        }
      }
    } else {
       // If deselecting, we could restore original images if we want, but typically it's fine.
    }

    updateVariantGroupsState();
  });

  // Call it once on load to set initial state
  if (variantGroupsContainer) {
    updateVariantGroupsState();
  }

  // Galería de thumbnails
  function attachThumbnailListeners() {
    document.querySelectorAll(".product-thumb").forEach((thumb) => {
      // Clone to remove old listeners if re-attaching
      const newThumb = thumb.cloneNode(true);
      thumb.parentNode?.replaceChild(newThumb, thumb);

      newThumb.addEventListener("click", () => {
        const src = newThumb.getAttribute("data-src");
        const mainImg = document.getElementById("main-image");
        if (mainImg && src) mainImg.src = src;

        document.querySelectorAll(".product-thumb").forEach((t) => {
          t.classList.remove("border-primary");
          t.classList.add("border-transparent");
        });
        newThumb.classList.add("border-primary");
        newThumb.classList.remove("border-transparent");
      });
    });
  }

  attachThumbnailListeners();

  // Cantidad
  const qtyMinus = document.getElementById("qty-minus");
  const qtyPlus = document.getElementById("qty-plus");
  const minOrder = parseInt(qtyInput?.min || "1");

  qtyMinus?.addEventListener("click", () => {
    const current = parseInt(qtyInput.value);
    if (current > minOrder) {
      qtyInput.value = String(current - 1);
      updateProductionTime();
      updatePricingDisplays(currentBasePrice);
    }
  });

  qtyPlus?.addEventListener("click", () => {
    const current = parseInt(qtyInput.value);
    qtyInput.value = String(current + 1);
    updateProductionTime();
    updatePricingDisplays(currentBasePrice);
  });

  qtyInput?.addEventListener("change", () => {
    updateProductionTime();
    updatePricingDisplays(currentBasePrice);
  });

  // Production time dynamic update
  function updateProductionTime() {
    const display = document.getElementById("production-time-display");
    const container = document.getElementById("production-time-container");
    if (!display) return;

    const qty = parseInt(qtyInput?.value || "1");
    const rules = (window as any).__productionTimeRules || [];
    const fallback = (window as any).__productionTimeFallback || null;

    if (rules.length === 0 && !fallback) return;

    const applicableRule = rules
      .filter(
        (r: any) =>
          qty >= r.minQuantity &&
          (r.maxQuantity === null || qty <= r.maxQuantity),
      )
      .sort((a: any, b: any) => b.minQuantity - a.minQuantity)[0];

    const time = applicableRule
      ? applicableRule.productionTime
      : fallback || "A consultar";
    display.textContent = time;
    if (container) container.style.display = "";
  }

  // Initial calculation on page load
  document.addEventListener("DOMContentLoaded", () => {
    updateProductionTime();
    updatePricingDisplays(currentBasePrice);
  });

  // Since this is a module script, DOMContentLoaded might have already fired
  if (
    document.readyState === "interactive" ||
    document.readyState === "complete"
  ) {
    updateProductionTime();
    updatePricingDisplays(currentBasePrice);
  }
</script>

<script
  is:inline
  define:vars={{
    productionTimeRules: JSON.stringify(productionTimeRules),
    productionTimeFallback: product.productionTime || "",
    priceRules: JSON.stringify(priceRules),
    productImages: JSON.stringify(images),
    productBasePrice: finalPrice,
    productSku: product.sku || "",
  }}
>
  // Make production time and price rules data available to the main script
  window.__productionTimeRules = JSON.parse(productionTimeRules);
  window.__productionTimeFallback = productionTimeFallback || null;
  window.__priceRules = JSON.parse(priceRules);
  window.__productImages = JSON.parse(productImages);
  window.__productBasePrice = productBasePrice;
  window.__productSku = productSku;
</script>
