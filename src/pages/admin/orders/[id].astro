---
import AdminLayout from '@/layouts/AdminLayout.astro';
import { db } from '@/lib/db/connection';
import { orders, addresses } from '@/lib/db/schema';
import { eq } from 'drizzle-orm';
import { ArrowLeft, Package, User, MapPin, CreditCard, Trash2, Save, Truck, Download, RefreshCw, ExternalLink, Mail, AlertTriangle } from 'lucide-react';
import { sanitizePublicUrl } from '@/lib/security/html';
import { formatIsoDuration, getZipnovaLabelState } from '@/lib/shipping/zipnovaShipment';

const { id } = Astro.params;

if (!id) return Astro.redirect('/admin/orders');

// Fetch order with related data
const order = await db.query.orders.findFirst({
    where: eq(orders.id, id),
    with: {
        user: true,
        items: {
            with: {
                product: true
            }
        }
    }
});

if (!order) return Astro.redirect('/admin/orders');

let shippingAddress = null;
if (order.shippingAddressId) {
    shippingAddress = await db.query.addresses.findFirst({
        where: eq(addresses.id, order.shippingAddressId)
    });
}

const statusOptions = [
    { value: 'pending', label: 'Pendiente' },
    { value: 'confirmed', label: 'Confirmada' },
    { value: 'processing', label: 'Procesando' },
    { value: 'shipped', label: 'Enviado' },
    { value: 'delivered', label: 'Entregado' },
    { value: 'cancelled', label: 'Cancelado' },
];

const paymentStatusOptions = [
    { value: 'pending', label: 'Pendiente' },
    { value: 'approved', label: 'Pagado' },
    { value: 'rejected', label: 'Fallido' },
];

// Procesar shippingData fuera del template para evitar errores de compilación
const shipping = order.shippingData as any;
const selectedShipping = shipping?.selectedShipping;
const shipment = shipping?.zipnovaShipment;
const trackingUrl = sanitizePublicUrl(shipment?.trackingExternal || shipment?.tracking);
const labelState = getZipnovaLabelState(shipment);
const formatShippingDate = (value: unknown, includeTime = false) => {
    if (!value) return '';
    const date = new Date(String(value));
    if (Number.isNaN(date.getTime())) return '';
    return date.toLocaleString('es-AR', {
        timeZone: 'America/Argentina/Buenos_Aires',
        day: '2-digit',
        month: '2-digit',
        year: 'numeric',
        ...(includeTime ? { hour: '2-digit', minute: '2-digit' } : {}),
    });
};
const quotedDelivery = formatShippingDate(
    selectedShipping?.quotedEstimatedDelivery || (!shipment ? selectedShipping?.estimatedDelivery : null),
);
const currentDelivery = formatShippingDate(shipment?.estimatedDelivery);
const dropoffDeadline = formatShippingDate(shipment?.dropoffDeadlineAt, true);
const preparationDuration = formatIsoDuration(shipment?.preparationTime || selectedShipping?.preparationTime);
const carrierDuration = formatIsoDuration(shipment?.carrierTime || selectedShipping?.shippingTime);
const documentValue = String(shipping?.document || shipping?.dni || shipping?.cuit || shipping?.transfer_dni || '').replace(/\D/g, '');
const deliveryAddress = {
    street: shippingAddress?.street || shipping?.street || '',
    number: shippingAddress?.number || shipping?.number || shipping?.street_number || '',
    extras: [shippingAddress?.floor, shippingAddress?.apartment].filter(Boolean).join(' ') || shipping?.floor_apt || '',
    city: shippingAddress?.city || shipping?.city || '',
    state: shippingAddress?.state || shipping?.state || '',
    postalCode: shippingAddress?.postalCode || shipping?.postal_code || shipping?.zipcode || '',
};

const customerDisplayName = shipping?.full_name || order.user?.name || 'Invitado';
const customerDisplayEmail = shipping?.email || order.user?.email || 'N/A';
const customerDisplayPhone = shipping?.phone || order.user?.phone || '-';
---

<AdminLayout title={`Orden #${order.orderNumber}`}>
    <div class="mb-6">
        <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
            <div>
                <a href="/admin/orders" class="inline-flex items-center text-sm text-gray-500 hover:text-gray-700 mb-2">
                    <ArrowLeft className="w-4 h-4 mr-1" />
                    Volver a la lista
                </a>
                <h1 class="text-2xl font-bold text-gray-900">
                    Orden <span class="text-indigo-600">#{order.orderNumber}</span>
                </h1>
                <p class="text-sm text-gray-500">
                    Realizada el {order.createdAt ? new Date(order.createdAt).toLocaleString() : '-'}
                </p>
            </div>
            <div class="flex items-center gap-3" id="delete-container">
                <button 
                    type="button"
                    id="delete-order-btn"
                    class="inline-flex items-center px-4 py-2 border border-rose-200 text-rose-600 bg-rose-50 hover:bg-rose-600 hover:text-white rounded-lg transition-all text-sm font-medium"
                >
                    <Trash2 className="w-4 h-4 mr-2" />
                    Eliminar Orden
                </button>

                <div id="confirm-delete-box" class="hidden items-center gap-2 bg-rose-50 p-1 rounded-lg border border-rose-100 animate-in fade-in zoom-in duration-200">
                    <span class="text-xs text-rose-700 font-bold px-2">¿Seguro?</span>
                    <button 
                        type="button"
                        id="final-delete-btn" 
                        class="bg-rose-600 text-white px-3 py-1.5 rounded-md text-xs font-bold hover:bg-rose-700 transition-colors shadow-sm"
                    >
                        Sí, eliminar
                    </button>
                    <button 
                        type="button"
                        id="cancel-delete-btn" 
                        class="bg-white text-gray-600 px-3 py-1.5 rounded-md text-xs font-medium border border-gray-200 hover:bg-gray-50 transition-colors"
                    >
                        No
                    </button>
                </div>
            </div>
        </div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
        <!-- Main Content (Items & Shipping) -->
        <div class="lg:col-span-2 space-y-6">
            <div class="bg-white p-6 rounded-lg shadow-sm border border-gray-100">
                <h2 class="text-lg font-medium text-gray-900 mb-4 border-b pb-2 flex items-center">
                    <Package className="w-5 h-5 mr-2 text-gray-400" />
                    Ítems del Pedido
                </h2>
                <div class="overflow-x-auto">
                    <table class="min-w-full divide-y divide-gray-200">
                        <thead>
                            <tr>
                                <th class="px-3 py-2 text-left text-xs font-medium text-gray-500 uppercase">Producto</th>
                                <th class="px-3 py-2 text-left text-xs font-medium text-gray-500 uppercase">Precio</th>
                                <th class="px-3 py-2 text-left text-xs font-medium text-gray-500 uppercase">Cant.</th>
                                <th class="px-3 py-2 text-right text-xs font-medium text-gray-500 uppercase">Subtotal</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-gray-200">
                            {order.items.map((item) => (
                                <tr>
                                    <td class="px-3 py-3 text-sm text-gray-900">
                                        <div class="font-medium">{item.productName}</div>
                                        {item.productSku && <div class="text-xs text-gray-500">SKU: {item.productSku}</div>}
                                        {item.variantId && (
                                            <div class="text-xs text-indigo-600 font-medium">Variante: {item.product?.name || 'Cargando...'}</div>
                                        )}
                                        {item.customization && (
                                            <div class="text-xs text-amber-600 mt-1 italic border-l-2 border-amber-200 pl-2">
                                                Personalización: {JSON.stringify(item.customization)}
                                            </div>
                                        )}
                                    </td>
                                    <td class="px-3 py-3 text-sm text-gray-500">${parseFloat(item.unitPrice).toFixed(2)}</td>
                                    <td class="px-3 py-3 text-sm text-gray-500">{item.quantity}</td>
                                    <td class="px-3 py-3 text-sm text-gray-900 text-right font-medium">${parseFloat(item.subtotal).toFixed(2)}</td>
                                </tr>
                            ))}
                        </tbody>
                        <tfoot>
                             <tr>
                                <td colspan="3" class="px-3 py-3 text-sm font-medium text-gray-900 text-right">Subtotal:</td>
                                <td class="px-3 py-3 text-sm text-gray-900 text-right">${parseFloat(order.subtotal).toFixed(2)}</td>
                            </tr>
                            {parseFloat(order.shippingCost || '0') > 0 && (
                                <tr>
                                    <td colspan="3" class="px-3 py-3 text-sm font-medium text-gray-900 text-right">Envío:</td>
                                    <td class="px-3 py-3 text-sm text-gray-900 text-right">${parseFloat(order.shippingCost || '0').toFixed(2)}</td>
                                </tr>
                            )}
                            {parseFloat(order.discountAmount || '0') > 0 && (
                                <tr>
                                    <td colspan="3" class="px-3 py-3 text-sm font-medium text-gray-900 text-right text-green-600">Descuento:</td>
                                    <td class="px-3 py-3 text-sm text-green-600 text-right">-${parseFloat(order.discountAmount || '0').toFixed(2)}</td>
                                </tr>
                            )}
                            <tr class="bg-gray-50">
                                <td colspan="3" class="px-3 py-3 text-base font-bold text-gray-900 text-right">Total:</td>
                                <td class="px-3 py-3 text-base font-bold text-gray-900 text-right">${parseFloat(order.total).toFixed(2)}</td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </div>

            <!-- Shipping Info (Horizontal below items) -->
            <div class="bg-white p-6 rounded-lg shadow-sm border border-gray-100">
                <h2 class="text-lg font-medium text-gray-900 mb-4 border-b pb-2 flex items-center">
                    <MapPin className="w-5 h-5 mr-2 text-gray-400" />
                    Datos de Envío y Entrega
                </h2>
                {order.salesChannel !== 'app' ? (
                    <div class="rounded-xl border border-sky-100 bg-sky-50 p-4 text-sm text-sky-800">
                        La dirección y los datos protegidos del comprador se consultan en la orden de Mercado Libre.
                    </div>
                ) : order.shippingMethod === 'pickup' ? (
                    <div class="rounded-xl border border-amber-100 bg-amber-50 p-4 text-sm text-amber-800">
                        Retiro en local. No requiere generar una etiqueta de transporte.
                    </div>
                ) : (
                    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 text-sm">
                        <div class="space-y-1">
                            <span class="text-xs text-gray-400 uppercase font-bold block">Destinatario</span>
                            <p class="font-medium text-gray-900">{customerDisplayName}</p>
                            <p class="text-gray-600">{customerDisplayPhone}</p>
                        </div>
                        <div class="space-y-1">
                            <span class="text-xs text-gray-400 uppercase font-bold block">Dirección</span>
                            <p class="text-gray-900">{deliveryAddress.street} {deliveryAddress.number}</p>
                            {deliveryAddress.extras && <p class="text-gray-600">{deliveryAddress.extras}</p>}
                        </div>
                        <div class="space-y-1">
                            <span class="text-xs text-gray-400 uppercase font-bold block">Localidad</span>
                            <p class="text-gray-900">{deliveryAddress.city}, {deliveryAddress.state}</p>
                            <p class="text-gray-600">CP: {deliveryAddress.postalCode}</p>
                        </div>
                    </div>
                )}
            </div>

            <!-- Fulfillment / Zipnova -->
            <div class="bg-white p-6 rounded-lg shadow-sm border border-gray-100">
                <div class="mb-4 flex flex-col gap-3 border-b pb-4 sm:flex-row sm:items-center sm:justify-between">
                    <h2 class="flex items-center text-lg font-medium text-gray-900">
                        <Truck className="mr-2 h-5 w-5 text-gray-400" />
                        Despacho y etiqueta
                    </h2>
                    {shipment?.statusName && (
                        <span class="inline-flex w-fit items-center rounded-full border border-sky-100 bg-sky-50 px-3 py-1 text-xs font-bold text-sky-700">
                            {shipment.statusName}
                        </span>
                    )}
                </div>

                {order.salesChannel !== 'app' ? (
                    <div class="rounded-xl border border-sky-100 bg-sky-50 p-4 text-sm text-sky-800">
                        Esta venta proviene de Mercado Libre. La etiqueta se gestiona con Mercado Envíos desde la orden de Mercado Libre.
                    </div>
                ) : order.shippingMethod !== 'delivery' ? (
                    <p class="text-sm text-gray-500">No hace falta etiqueta porque el cliente retira su pedido.</p>
                ) : (
                    <div class="space-y-5">
                        <div class="grid grid-cols-1 gap-4 text-sm sm:grid-cols-3">
                            <div>
                                <span class="block text-[10px] font-bold uppercase tracking-wider text-gray-400">Transporte</span>
                                <p class="mt-1 font-semibold text-gray-900">{shipment?.carrierName || selectedShipping?.carrierName || 'Sin seleccionar'}</p>
                            </div>
                            <div>
                                <span class="block text-[10px] font-bold uppercase tracking-wider text-gray-400">Servicio</span>
                                <p class="mt-1 font-semibold text-gray-900">{selectedShipping?.serviceTypeName || '-'}</p>
                            </div>
                            <div>
                                <span class="block text-[10px] font-bold uppercase tracking-wider text-gray-400">Costo cobrado</span>
                                <p class="mt-1 font-semibold text-gray-900">${Number(order.shippingCost || 0).toLocaleString('es-AR')}</p>
                            </div>
                        </div>

                        {(quotedDelivery || currentDelivery || preparationDuration || carrierDuration) && (
                            <div class="grid grid-cols-1 gap-3 rounded-xl border border-gray-100 bg-gray-50 p-4 text-sm sm:grid-cols-2 lg:grid-cols-4">
                                {quotedDelivery && (
                                    <div><span class="block text-[10px] font-bold uppercase text-gray-400">Estimación al comprar</span><strong class="mt-1 block text-gray-800">Hasta el {quotedDelivery}</strong></div>
                                )}
                                {currentDelivery && (
                                    <div><span class="block text-[10px] font-bold uppercase text-gray-400">Estimación actual</span><strong class="mt-1 block text-gray-800">Hasta el {currentDelivery}</strong></div>
                                )}
                                {preparationDuration && (
                                    <div><span class="block text-[10px] font-bold uppercase text-gray-400">Preparación logística</span><strong class="mt-1 block text-gray-800">{preparationDuration}</strong></div>
                                )}
                                {carrierDuration && (
                                    <div><span class="block text-[10px] font-bold uppercase text-gray-400">Trayecto del correo</span><strong class="mt-1 block text-gray-800">{carrierDuration}</strong></div>
                                )}
                            </div>
                        )}

                        {order.zipnovaShipmentId ? (
                            <div class:list={["rounded-2xl p-4", labelState.stalled ? "border border-rose-200 bg-rose-50" : "border border-emerald-100 bg-emerald-50/60"]}>
                                <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
                                    <div>
                                        <p class:list={["text-xs font-bold uppercase tracking-wider", labelState.stalled ? "text-rose-700" : "text-emerald-700"]}>Despacho Zipnova creado</p>
                                        <p class="mt-1 font-mono text-sm text-gray-700">ID {order.zipnovaShipmentId}</p>
                                        {shipment?.carrierTrackingId && <p class="mt-1 text-xs text-gray-500">Seguimiento: {shipment.carrierTrackingId}</p>}
                                        {dropoffDeadline && <p class="mt-1 text-xs text-gray-500">Despachar antes del {dropoffDeadline}</p>}
                                    </div>
                                    <div class="flex flex-wrap gap-2">
                                        <button id="download-label-btn" type="button" disabled={!labelState.ready} title={!labelState.ready ? labelState.message || 'Etiqueta pendiente' : 'Descargar etiqueta'} class:list={["inline-flex items-center rounded-xl px-4 py-2.5 text-sm font-bold text-white transition", labelState.ready ? "bg-emerald-600 hover:bg-emerald-700" : "cursor-not-allowed bg-gray-300"]}>
                                            <Download className="mr-2 h-4 w-4" /> Descargar etiqueta
                                        </button>
                                        <button id="refresh-shipment-btn" type="button" class="inline-flex items-center rounded-xl border border-gray-200 bg-white px-4 py-2.5 text-sm font-bold text-gray-700 transition hover:bg-gray-50">
                                            <RefreshCw className="mr-2 h-4 w-4" /> Actualizar
                                        </button>
                                        <button id="notify-customer-btn" type="button" disabled={!labelState.ready} title={!labelState.ready ? 'Se habilita cuando Zipnova genere la documentación' : 'Enviar los datos de seguimiento'} class:list={["inline-flex items-center rounded-xl border px-4 py-2.5 text-sm font-bold transition", labelState.ready ? "border-gray-200 bg-white text-gray-700 hover:bg-gray-50" : "cursor-not-allowed border-gray-100 bg-gray-100 text-gray-400"]}>
                                            <Mail className="mr-2 h-4 w-4" /> {shipment?.customerNotifiedAt ? 'Reenviar seguimiento' : 'Avisar al comprador'}
                                        </button>
                                        {trackingUrl && (
                                            <a href={trackingUrl} target="_blank" rel="noopener noreferrer" class="inline-flex items-center rounded-xl border border-gray-200 bg-white px-4 py-2.5 text-sm font-bold text-gray-700 transition hover:bg-gray-50">
                                                <ExternalLink className="mr-2 h-4 w-4" /> Seguimiento
                                            </a>
                                        )}
                                    </div>
                                </div>
                                {!labelState.ready && (
                                    <div class:list={["mt-4 flex gap-3 rounded-xl border p-3 text-sm", labelState.stalled ? "border-rose-200 bg-white text-rose-800" : "border-amber-100 bg-amber-50 text-amber-800"]}>
                                        <AlertTriangle className="mt-0.5 h-4 w-4 shrink-0" />
                                        <div>
                                            <p class="font-bold">{labelState.stalled ? 'Acción necesaria en Zipnova' : 'Documentación en preparación'}</p>
                                            <p class="mt-1 text-xs leading-relaxed">{labelState.message}</p>
                                        </div>
                                    </div>
                                )}
                                {shipment?.customerNotifiedAt && (
                                    <p class="mt-3 text-xs text-gray-500">Último aviso al comprador: {formatShippingDate(shipment.customerNotifiedAt, true)}</p>
                                )}
                            </div>
                        ) : !Number(selectedShipping?.carrierId) ? (
                            <div class="rounded-xl border border-gray-200 bg-gray-50 p-4 text-sm text-gray-700">
                                Esta orden usa una tarifa manual. Prepará el envío fuera de Zipnova o volvé a cotizar con un transporte integrado.
                            </div>
                        ) : order.paymentStatus !== 'approved' ? (
                            <div class="rounded-xl border border-amber-100 bg-amber-50 p-4 text-sm text-amber-800">
                                Cuando el pago figure como aprobado vas a poder generar el despacho y descargar su etiqueta desde acá.
                            </div>
                        ) : (
                            <div class="rounded-2xl border border-indigo-100 bg-indigo-50/50 p-4">
                                <p class="text-sm font-semibold text-gray-900">Listo para generar el despacho</p>
                                <p class="mt-1 text-xs leading-relaxed text-gray-500">Esta acción crea el envío real en Zipnova. Se puede ejecutar una sola vez por orden.</p>
                                <div class="mt-4 flex flex-col gap-3 sm:flex-row sm:items-end">
                                    <label class="flex-1 text-xs font-bold text-gray-600">
                                        DNI/CUIT del destinatario
                                        <input id="shipment-document" type="text" inputmode="numeric" value={documentValue} placeholder="Ej: 30123456" class="mt-1 block h-11 w-full rounded-xl border border-gray-200 bg-white px-3 text-sm font-normal focus:border-indigo-500 focus:ring-indigo-500" />
                                    </label>
                                    <button id="create-shipment-btn" type="button" class="inline-flex h-11 items-center justify-center rounded-xl bg-indigo-600 px-5 text-sm font-bold text-white transition hover:bg-indigo-700">
                                        <Truck className="mr-2 h-4 w-4" /> Generar despacho
                                    </button>
                                </div>
                            </div>
                        )}
                    </div>
                )}
            </div>
        </div>

        <!-- Sidebar Info -->
        <div class="space-y-6">
            <!-- Customer Info -->
            <div class="bg-white p-6 rounded-lg shadow-sm border border-gray-100 text-wrap overflow-hidden">
                <h2 class="text-lg font-medium text-gray-900 mb-4 border-b pb-2 flex items-center">
                    <User className="w-5 h-5 mr-2 text-gray-400" />
                    Cliente
                </h2>
                <div class="space-y-3 text-sm">
                    <div class="break-words">
                        <span class="block text-gray-500 text-[10px] uppercase font-bold mb-0.5 tracking-wider">Nombre</span>
                        <span class="font-semibold text-gray-900 text-base">{customerDisplayName}</span>
                    </div>
                    <div class="break-all">
                        <span class="block text-gray-500 text-[10px] uppercase font-bold mb-0.5 tracking-wider">Email</span>
                        <span class="font-medium text-gray-700">{customerDisplayEmail}</span>
                    </div>
                    <div>
                        <span class="block text-gray-500 text-[10px] uppercase font-bold mb-0.5 tracking-wider">Teléfono</span>
                        <span class="font-medium text-gray-700">{customerDisplayPhone}</span>
                    </div>
                </div>
            </div>

            <!-- Status Management -->
            <div class="bg-white p-6 rounded-lg shadow-sm border border-gray-100">
                <h2 class="text-lg font-medium text-gray-900 mb-4 border-b pb-2">Estado del Pedido</h2>
                
                <form id="status-form" class="space-y-4">
                    <div>
                        <label for="status" class="block text-xs font-bold text-gray-400 uppercase mb-1 tracking-wider">Estado General</label>
                        <select id="status" name="status" class="block w-full rounded-md border-gray-200 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 text-sm border h-10 px-3 bg-gray-50/50 transition-colors">
                            {statusOptions.map(opt => (
                                <option value={opt.value} selected={order.status === opt.value}>{opt.label}</option>
                            ))}
                        </select>
                    </div>

                    <div>
                        <label for="paymentStatus" class="block text-xs font-bold text-gray-400 uppercase mb-1 tracking-wider">Estado del Pago</label>
                        <select id="paymentStatus" name="paymentStatus" class="block w-full rounded-md border-gray-200 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 text-sm border h-10 px-3 bg-gray-50/50 transition-colors">
                            {paymentStatusOptions.map(opt => (
                                <option value={opt.value} selected={order.paymentStatus === opt.value}>{opt.label}</option>
                            ))}
                        </select>
                    </div>

                    <button type="submit" class="w-full flex items-center justify-center py-2.5 px-4 border border-transparent rounded-xl shadow-sm text-sm font-bold text-white bg-indigo-600 hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500 transition-all active:scale-95 shadow-indigo-100">
                        <Save className="w-4 h-4 mr-2" />
                        Guardar Cambios
                    </button>
                </form>
            </div>

             <!-- Payment method -->
            <div class="bg-white p-6 rounded-lg shadow-sm border border-gray-100">
                <h2 class="text-lg font-medium text-gray-900 mb-4 border-b pb-2 flex items-center">
                    <CreditCard className="w-5 h-5 mr-2 text-gray-400" />
                    Pago
                </h2>
                <div class="space-y-2 text-sm">
                     <div>
                        <span class="block text-gray-500 text-[10px] uppercase font-bold mb-1 tracking-wider">Método</span>
                        <span class="font-bold text-gray-900 uppercase py-1 px-3 bg-indigo-50 text-indigo-700 text-xs rounded-full border border-indigo-100 inline-block">{order.paymentMethod}</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</AdminLayout>

<script is:inline define:vars={{ id }}>
    console.log('Controlador de orden cargado:', id);

    function initHandlers() {
        const deleteBtn = document.getElementById('delete-order-btn');
        const confirmBox = document.getElementById('confirm-delete-box');
        const finalDeleteBtn = document.getElementById('final-delete-btn');
        const cancelDeleteBtn = document.getElementById('cancel-delete-btn');
        const statusForm = document.getElementById('status-form');
        const createShipmentBtn = document.getElementById('create-shipment-btn');
        const refreshShipmentBtn = document.getElementById('refresh-shipment-btn');
        const downloadLabelBtn = document.getElementById('download-label-btn');
        const notifyCustomerBtn = document.getElementById('notify-customer-btn');

        if (createShipmentBtn && !createShipmentBtn.dataset.handled) {
            createShipmentBtn.dataset.handled = 'true';
            createShipmentBtn.addEventListener('click', async () => {
                const documentInput = document.getElementById('shipment-document');
                const recipientDocument = documentInput instanceof HTMLInputElement ? documentInput.value.trim() : '';
                if (!/^\d{7,11}$/.test(recipientDocument.replace(/\D/g, ''))) {
                    window.showToast('Ingresá un DNI/CUIT válido', 'error');
                    documentInput?.focus();
                    return;
                }
                if (!window.confirm('Se creará el despacho real en Zipnova para esta orden. ¿Continuar?')) return;

                const original = createShipmentBtn.innerHTML;
                createShipmentBtn.disabled = true;
                createShipmentBtn.innerHTML = 'Generando...';
                try {
                    const response = await fetch(`/api/admin/orders/${id}/shipment`, {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ document: recipientDocument }),
                    });
                    const payload = await response.json();
                    if (!response.ok) throw new Error(payload.error || 'No se pudo generar el despacho');
                    window.showToast('Despacho creado. Zipnova está preparando la documentación.');
                    setTimeout(() => window.location.reload(), 900);
                } catch (error) {
                    window.showToast(error instanceof Error ? error.message : 'No se pudo generar el despacho', 'error');
                    createShipmentBtn.disabled = false;
                    createShipmentBtn.innerHTML = original;
                }
            });
        }

        if (refreshShipmentBtn && !refreshShipmentBtn.dataset.handled) {
            refreshShipmentBtn.dataset.handled = 'true';
            refreshShipmentBtn.addEventListener('click', async () => {
                refreshShipmentBtn.disabled = true;
                try {
                    const response = await fetch(`/api/admin/orders/${id}/shipment`);
                    const payload = await response.json();
                    if (!response.ok) throw new Error(payload.error || 'No se pudo actualizar');
                    window.showToast('Estado del despacho actualizado');
                    setTimeout(() => window.location.reload(), 700);
                } catch (error) {
                    window.showToast(error instanceof Error ? error.message : 'No se pudo actualizar', 'error');
                    refreshShipmentBtn.disabled = false;
                }
            });
        }

        if (downloadLabelBtn && !downloadLabelBtn.dataset.handled) {
            downloadLabelBtn.dataset.handled = 'true';
            downloadLabelBtn.addEventListener('click', async () => {
                const original = downloadLabelBtn.innerHTML;
                downloadLabelBtn.disabled = true;
                downloadLabelBtn.innerHTML = 'Preparando...';
                try {
                    const response = await fetch(`/api/admin/orders/${id}/shipment/label`);
                    if (!response.ok) {
                        const payload = await response.json();
                        throw new Error(payload.error || 'La etiqueta todavía no está disponible');
                    }
                    const blob = await response.blob();
                    const url = URL.createObjectURL(blob);
                    const link = document.createElement('a');
                    link.href = url;
                    link.download = `etiqueta-${id}.pdf`;
                    document.body.appendChild(link);
                    link.click();
                    link.remove();
                    URL.revokeObjectURL(url);
                } catch (error) {
                    window.showToast(error instanceof Error ? error.message : 'No se pudo descargar la etiqueta', 'error');
                } finally {
                    downloadLabelBtn.disabled = false;
                    downloadLabelBtn.innerHTML = original;
                }
            });
        }

        if (notifyCustomerBtn && !notifyCustomerBtn.dataset.handled) {
            notifyCustomerBtn.dataset.handled = 'true';
            notifyCustomerBtn.addEventListener('click', async () => {
                if (notifyCustomerBtn.disabled) return;
                if (!window.confirm('Se enviará al comprador un email con el transporte, la fecha estimada y el enlace de seguimiento. ¿Continuar?')) return;
                const original = notifyCustomerBtn.innerHTML;
                notifyCustomerBtn.disabled = true;
                notifyCustomerBtn.innerHTML = 'Enviando...';
                try {
                    const response = await fetch(`/api/admin/orders/${id}/shipment/notify`, { method: 'POST' });
                    const payload = await response.json();
                    if (!response.ok) throw new Error(payload.error || 'No se pudo avisar al comprador');
                    window.showToast('Datos de seguimiento enviados al comprador');
                    setTimeout(() => window.location.reload(), 800);
                } catch (error) {
                    window.showToast(error instanceof Error ? error.message : 'No se pudo avisar al comprador', 'error');
                    notifyCustomerBtn.disabled = false;
                    notifyCustomerBtn.innerHTML = original;
                }
            });
        }

        if (deleteBtn && !deleteBtn.dataset.handled) {
            deleteBtn.dataset.handled = "true";
            deleteBtn.addEventListener('click', () => {
                deleteBtn.classList.add('hidden');
                confirmBox?.classList.remove('hidden');
                confirmBox?.classList.add('flex');
            });
        }

        if (cancelDeleteBtn) {
            cancelDeleteBtn.onclick = () => {
                confirmBox?.classList.add('hidden');
                confirmBox?.classList.remove('flex');
                deleteBtn?.classList.remove('hidden');
            };
        }

        if (finalDeleteBtn && !finalDeleteBtn.dataset.handled) {
            finalDeleteBtn.dataset.handled = "true";
            finalDeleteBtn.addEventListener('click', async () => {
                finalDeleteBtn.disabled = true;
                const originalText = finalDeleteBtn.innerHTML;
                finalDeleteBtn.innerHTML = 'Borrando...';
                
                try {
                    console.log('Enviando solicitud DELETE para:', id);
                    const response = await fetch(`/api/orders/${id}`, { method: 'DELETE' });
                    
                        if (response.ok) {
                            window.showToast('Orden eliminada correctamente');
                            setTimeout(() => window.location.href = '/admin/orders', 1500);
                        } else {
                            const error = await response.json();
                            window.showToast('Error: ' + (error.error || 'No se pudo eliminar'), 'error');
                            finalDeleteBtn.disabled = false;
                            finalDeleteBtn.innerHTML = originalText;
                        }
                    } catch (err) {
                        console.error('Error en fetch:', err);
                        window.showToast('Error de conexión con el servidor', 'error');
                    finalDeleteBtn.disabled = false;
                    finalDeleteBtn.innerHTML = originalText;
                }
            });
        }

        if (statusForm && !statusForm.dataset.handled) {
            statusForm.dataset.handled = "true";
            statusForm.addEventListener('submit', async (e) => {
                e.preventDefault();
                const btn = statusForm.querySelector('button[type="submit"]');
                const originalText = btn.innerHTML;
                btn.disabled = true;
                btn.innerHTML = 'Guardando...';

                const data = Object.fromEntries(new FormData(statusForm));
                try {
                    const response = await fetch(`/api/orders/${id}`, {
                        method: 'PUT',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify(data)
                    });

                    if (response.ok) {
                        window.showToast('Cambios guardados con éxito');
                        setTimeout(() => window.location.reload(), 1500);
                    } else {
                        const err = await response.json();
                        window.showToast('Error: ' + err.error, 'error');
                        btn.disabled = false;
                        btn.innerHTML = originalText;
                    }
                } catch (err) {
                    window.showToast('Error de red', 'error');
                    btn.disabled = false;
                    btn.innerHTML = originalText;
                }
            });
        }
    }

    initHandlers();
    document.addEventListener('astro:page-load', initHandlers);
    document.addEventListener('astro:after-swap', initHandlers);
</script>
