---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { db } from '../../../lib/db/connection';
import { meliItemLinks, meliOrders, products } from '../../../lib/db/schema';
import { asc, desc } from 'drizzle-orm';

const [ordersData, productCatalog, itemLinks] = await Promise.all([
  db.select().from(meliOrders).orderBy(desc(meliOrders.dateCreated)).limit(100),
  db.select({ id: products.id, name: products.name, sku: products.sku })
    .from(products)
    .orderBy(asc(products.name)),
  db.select({
    meliItemId: meliItemLinks.meliItemId,
    meliVariationId: meliItemLinks.meliVariationId,
    productId: meliItemLinks.productId,
    packQuantity: meliItemLinks.packQuantity,
  }).from(meliItemLinks),
]);

const productById = new Map(productCatalog.map((product) => [product.id, product]));
const linkByKey = new Map(itemLinks.map((link) => [
  `${link.meliItemId}::${link.meliVariationId || ''}`,
  link,
]));

const getItemLink = (meliItemId: string, variationId: string | null) =>
  linkByKey.get(`${meliItemId}::${variationId || ''}`)
  || linkByKey.get(`${meliItemId}::`);

const orders = ordersData.map((order) => {
  const displayItems = (order.items || []).map((item) => {
    const link = getItemLink(item.meliItemId, item.variationId);
    const productId = link?.productId || item.productId;
    const product = productId ? productById.get(Number(productId)) : null;
    const packQuantity = Number(link?.packQuantity || item.packQuantity || 1);
    const quantity = Number(item.quantity || 0);

    return {
      ...item,
      productId: productId || null,
      productName: product?.name || null,
      productSku: product?.sku || null,
      packQuantity,
      quantity,
      internalUnits: quantity * packQuantity,
      isLinked: Boolean(productId && product),
    };
  });

  const missingLinks = displayItems.filter((item) => !item.isLinked).length;
  const stage = order.status === 'cancelled'
    ? 'cancelled'
    : missingLinks > 0
      ? 'needs_link'
      : order.internalOrderId
        ? 'included'
        : order.status === 'paid'
          ? 'ready'
          : 'pending';

  return {
    ...order,
    displayItems,
    missingLinks,
    stage,
    searchText: [
      order.meliOrderId,
      order.buyerNickname,
      order.buyerEmail,
      ...displayItems.flatMap((item) => [
        item.title,
        item.sku,
        item.meliItemId,
        item.variationId,
        item.productName,
        item.productSku,
      ]),
    ].filter(Boolean).join(' ').toLocaleLowerCase('es-AR'),
  };
});

const paidOrders = orders.filter((order) => order.status === 'paid');
const needsLinkCount = orders.filter((order) => order.stage === 'needs_link').length;
const includedCount = orders.filter((order) => order.stage === 'included').length;
const reconciledCount = orders.filter((order) => order.financialStatus === 'reconciled').length;
const paidTotal = paidOrders.reduce((sum, order) => sum + Number(order.totalAmount || 0), 0);

const money = (value: unknown) => Number(value || 0).toLocaleString('es-AR', {
  style: 'currency',
  currency: 'ARS',
  maximumFractionDigits: 2,
});

const statusLabel = (status: string) => ({
  paid: 'Pagada',
  cancelled: 'Cancelada',
  pending: 'Pendiente',
}[status] || status);
---

<AdminLayout title="Órdenes de Mercado Libre">
  <div class="px-4 sm:px-6 lg:px-8 py-8 w-full max-w-9xl mx-auto">
    <header class="flex flex-col gap-5 xl:flex-row xl:items-start xl:justify-between mb-7">
      <div>
        <div class="flex items-center gap-3">
          <a href="/admin/meli" class="inline-flex h-9 w-9 items-center justify-center rounded-lg border border-slate-200 bg-white text-slate-500 hover:border-indigo-300 hover:text-indigo-600 dark:border-slate-700 dark:bg-slate-800" aria-label="Volver a Mercado Libre">
            <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path></svg>
          </a>
          <div>
            <h1 class="text-2xl md:text-3xl text-slate-800 dark:text-slate-100 font-bold">Órdenes de Mercado Libre</h1>
            <p class="mt-1 text-sm text-slate-500">Identificá qué vendiste, resolvé vínculos pendientes y controlá qué ventas entraron en Rentabilidad.</p>
          </div>
        </div>
      </div>
      <div class="flex flex-wrap gap-2">
        {needsLinkCount > 0 && (
          <button id="btnResolveNext" class="btn bg-amber-500 hover:bg-amber-600 text-white shadow-sm">Resolver siguiente ({needsLinkCount})</button>
        )}
        <button id="btnReconcile" class="btn bg-emerald-600 hover:bg-emerald-700 text-white">Conciliar cargos</button>
        <button id="btnImport" class="btn bg-indigo-500 hover:bg-indigo-600 text-white">
          <svg class="w-4 h-4 fill-current opacity-60 shrink-0 mr-2" viewBox="0 0 16 16"><path d="M15 7H9V1c0-.6-.4-1-1-1S7 .4 7 1v6H1c-.6 0-1 .4-1 1s.4 1 1 1h6v6c0 .6.4 1 1 1s1-.4 1-1V9h6c.6 0 1-.4 1-1s-.4-1-1-1z"></path></svg>
          Importar recientes
        </button>
      </div>
    </header>

    <section class="grid grid-cols-2 gap-3 lg:grid-cols-4 mb-6" aria-label="Resumen de órdenes">
      <button type="button" data-quick-filter="all" class="text-left rounded-xl border border-slate-200 bg-white p-4 shadow-sm transition hover:border-indigo-300 dark:border-slate-700 dark:bg-slate-800">
        <span class="text-xs font-semibold uppercase tracking-wide text-slate-400">Ventas pagadas</span>
        <span class="mt-2 block text-2xl font-bold text-slate-800 dark:text-slate-100">{paidOrders.length}</span>
        <span class="mt-1 block text-xs text-slate-500">{money(paidTotal)} vendidos</span>
      </button>
      <button type="button" data-quick-filter="needs_link" class="text-left rounded-xl border border-amber-200 bg-amber-50 p-4 shadow-sm transition hover:border-amber-400 dark:border-amber-800/60 dark:bg-amber-900/10">
        <span class="text-xs font-semibold uppercase tracking-wide text-amber-700 dark:text-amber-400">Requieren acción</span>
        <span class="mt-2 block text-2xl font-bold text-amber-800 dark:text-amber-300">{needsLinkCount}</span>
        <span class="mt-1 block text-xs text-amber-700/70 dark:text-amber-400/70">Falta vincular productos</span>
      </button>
      <button type="button" data-quick-filter="included" class="text-left rounded-xl border border-emerald-200 bg-emerald-50 p-4 shadow-sm transition hover:border-emerald-400 dark:border-emerald-800/60 dark:bg-emerald-900/10">
        <span class="text-xs font-semibold uppercase tracking-wide text-emerald-700 dark:text-emerald-400">En Rentabilidad</span>
        <span class="mt-2 block text-2xl font-bold text-emerald-800 dark:text-emerald-300">{includedCount}</span>
        <span class="mt-1 block text-xs text-emerald-700/70 dark:text-emerald-400/70">Ventas internas creadas</span>
      </button>
      <button type="button" data-financial-filter="reconciled" class="text-left rounded-xl border border-sky-200 bg-sky-50 p-4 shadow-sm transition hover:border-sky-400 dark:border-sky-800/60 dark:bg-sky-900/10">
        <span class="text-xs font-semibold uppercase tracking-wide text-sky-700 dark:text-sky-400">Cargos reales</span>
        <span class="mt-2 block text-2xl font-bold text-sky-800 dark:text-sky-300">{reconciledCount}</span>
        <span class="mt-1 block text-xs text-sky-700/70 dark:text-sky-400/70">Órdenes conciliadas</span>
      </button>
    </section>

    <section class="mb-4 rounded-xl border border-slate-200 bg-white p-3 shadow-sm dark:border-slate-700 dark:bg-slate-800">
      <div class="flex flex-col gap-3 lg:flex-row lg:items-center">
        <label class="relative flex-1">
          <span class="sr-only">Buscar órdenes</span>
          <svg class="pointer-events-none absolute left-3 top-1/2 h-4 w-4 -translate-y-1/2 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-4.35-4.35m2.35-5.65a8 8 0 11-16 0 8 8 0 0116 0z"></path></svg>
          <input id="orderSearch" type="search" class="form-input w-full rounded-lg border-slate-200 pl-9 text-sm dark:border-slate-700 dark:bg-slate-900" placeholder="Buscar por orden, comprador, producto, SKU o publicación…" />
        </label>
        <label class="flex items-center gap-2 text-sm text-slate-500">
          <span>Mostrar</span>
          <select id="orderFilter" class="form-select min-w-56 rounded-lg border-slate-200 text-sm dark:border-slate-700 dark:bg-slate-900">
            <option value="all">Todas las órdenes</option>
            <option value="needs_link">Requieren vinculación</option>
            <option value="included">Incluidas en Rentabilidad</option>
            <option value="ready">Listas para procesar</option>
            <option value="cancelled">Canceladas</option>
          </select>
        </label>
        <div id="visibleCount" class="min-w-28 text-right text-xs font-medium text-slate-400"></div>
      </div>
    </section>

    <div id="ordersList" class="space-y-4">
      {orders.length === 0 && (
        <div class="rounded-xl border border-dashed border-slate-300 bg-white px-6 py-14 text-center dark:border-slate-700 dark:bg-slate-800">
          <div class="text-base font-semibold text-slate-700 dark:text-slate-200">Todavía no hay órdenes importadas</div>
          <p class="mt-1 text-sm text-slate-500">Usá “Importar recientes” para traer las ventas desde Mercado Libre.</p>
        </div>
      )}

      {orders.map((order) => (
        <article class={`overflow-hidden rounded-xl border bg-white shadow-sm transition dark:bg-slate-800 ${order.stage === 'needs_link' ? 'border-amber-300 dark:border-amber-700/70' : 'border-slate-200 dark:border-slate-700'}`} data-order-row data-stage={order.stage} data-financial={order.financialStatus} data-search={order.searchText}>
          <div class="flex flex-col gap-4 border-b border-slate-100 px-5 py-4 dark:border-slate-700/70 lg:flex-row lg:items-center lg:justify-between">
            <div class="flex flex-wrap items-center gap-x-4 gap-y-2">
              <div>
                <div class="flex items-center gap-2">
                  <span class="text-xs font-medium uppercase tracking-wide text-slate-400">Orden ML</span>
                  <button type="button" class="copy-order text-slate-400 hover:text-indigo-500" data-copy={order.meliOrderId} title="Copiar número de orden">
                    <svg class="h-3.5 w-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-4 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"></path></svg>
                  </button>
                </div>
                <div class="mt-0.5 font-mono text-sm font-bold text-slate-800 dark:text-slate-100">#{order.meliOrderId}</div>
              </div>
              <div class="h-8 w-px bg-slate-200 dark:bg-slate-700"></div>
              <div>
                <div class="text-xs text-slate-400">{new Date(order.dateCreated).toLocaleDateString('es-AR', { day: '2-digit', month: 'short', year: 'numeric' })}</div>
                <div class="mt-0.5 text-sm font-semibold text-slate-700 dark:text-slate-200">{order.buyerNickname || 'Comprador sin alias'}</div>
              </div>
            </div>
            <div class="flex flex-wrap items-center gap-2">
              <span class={`inline-flex rounded-full px-2.5 py-1 text-xs font-bold ${order.status === 'paid' ? 'bg-emerald-100 text-emerald-700' : order.status === 'cancelled' ? 'bg-rose-100 text-rose-700' : 'bg-slate-100 text-slate-600'}`}>{statusLabel(order.status)}</span>
              {order.status === 'cancelled' ? null : order.internalOrderId ? (
                <a href={`/admin/orders/${order.internalOrderId}`} class="inline-flex items-center gap-1 rounded-full bg-indigo-100 px-2.5 py-1 text-xs font-bold text-indigo-700 hover:bg-indigo-200">En Rentabilidad <span aria-hidden="true">›</span></a>
              ) : order.missingLinks > 0 ? (
                <span class="inline-flex rounded-full bg-amber-100 px-2.5 py-1 text-xs font-bold text-amber-800">{order.missingLinks} {order.missingLinks === 1 ? 'vínculo pendiente' : 'vínculos pendientes'}</span>
              ) : order.status === 'paid' ? (
                <span class="inline-flex rounded-full bg-sky-100 px-2.5 py-1 text-xs font-bold text-sky-700">Lista para procesar</span>
              ) : null}
              <span class={`inline-flex rounded-full px-2.5 py-1 text-xs font-medium ${order.financialStatus === 'reconciled' ? 'bg-sky-100 text-sky-700' : order.financialStatus === 'partially_reconciled' ? 'bg-amber-100 text-amber-700' : 'bg-slate-100 text-slate-500 dark:bg-slate-700 dark:text-slate-300'}`}>{order.financialStatus === 'reconciled' ? 'Cargos reales' : order.financialStatus === 'partially_reconciled' ? 'Detalle parcial' : 'Valores estimados'}</span>
            </div>
          </div>

          <div class="grid xl:grid-cols-[minmax(0,1fr)_22rem]">
            <div class="px-5 py-4">
              <div class="mb-3 flex items-center justify-between">
                <h2 class="text-xs font-bold uppercase tracking-wide text-slate-400">Qué se vendió</h2>
                <span class="text-xs text-slate-400">{order.displayItems.length} {order.displayItems.length === 1 ? 'producto' : 'productos'}</span>
              </div>
              <div class="space-y-3">
                {order.displayItems.length === 0 ? (
                  <div class="rounded-lg bg-slate-50 px-4 py-3 text-sm text-slate-500 dark:bg-slate-900/50">La orden no contiene detalle de productos. Volvé a importarla.</div>
                ) : order.displayItems.map((item) => (
                  <div class={`flex flex-col gap-3 rounded-lg border p-3 sm:flex-row sm:items-center sm:justify-between ${item.isLinked ? 'border-slate-200 dark:border-slate-700' : 'border-amber-200 bg-amber-50/60 dark:border-amber-800/70 dark:bg-amber-900/10'}`}>
                    <div class="min-w-0 flex-1">
                      <div class="flex flex-wrap items-center gap-2">
                        <span class="inline-flex h-7 min-w-7 items-center justify-center rounded-md bg-indigo-100 px-2 text-xs font-bold text-indigo-700">{item.quantity}×</span>
                        <div class="min-w-0 font-semibold text-slate-800 dark:text-slate-100">{item.title}</div>
                      </div>
                      <div class="mt-2 flex flex-wrap items-center gap-x-3 gap-y-1 text-xs text-slate-500">
                        {item.sku && <span>SKU ML: <strong class="font-mono text-slate-600 dark:text-slate-300">{item.sku}</strong></span>}
                        <a href={`https://articulo.mercadolibre.com.ar/${item.meliItemId.replace(/([A-Z]+)(\d+)/, '$1-$2')}`} target="_blank" rel="noreferrer" class="font-mono text-indigo-500 hover:text-indigo-600">{item.meliItemId} ↗</a>
                        {item.variationId && <span>Variante ML: <strong class="font-mono">{item.variationId}</strong></span>}
                        <span>{money(item.unitPrice)} c/u</span>
                      </div>
                      {item.isLinked ? (
                        <div class="mt-2 flex flex-wrap items-center gap-2 text-xs">
                          <span class="inline-flex items-center gap-1 rounded-md bg-emerald-100 px-2 py-1 font-semibold text-emerald-700">✓ {item.productName}</span>
                          {item.productSku && <span class="font-mono text-slate-400">SKU interno: {item.productSku}</span>}
                          <span class="text-slate-500">{item.quantity} venta × pack de {item.packQuantity} = <strong>{item.internalUnits} unidades internas</strong></span>
                        </div>
                      ) : (
                        <div class="mt-2 text-xs font-medium text-amber-700 dark:text-amber-400">Este producto todavía no puede calcular costos ni rentabilidad.</div>
                      )}
                    </div>
                    <button type="button" class={`link-item-btn shrink-0 rounded-lg px-3 py-2 text-xs font-bold transition ${item.isLinked ? 'border border-slate-200 text-slate-600 hover:border-indigo-300 hover:text-indigo-600 dark:border-slate-600 dark:text-slate-300' : 'bg-amber-500 text-white shadow-sm hover:bg-amber-600'}`} data-meli-item-id={item.meliItemId} data-variation-id={item.variationId || ''} data-item-title={item.title} data-product-id={item.productId || ''} data-pack-quantity={item.packQuantity}>{item.isLinked ? 'Cambiar vínculo' : 'Vincular ahora'}</button>
                  </div>
                ))}
              </div>
            </div>

            <aside class="border-t border-slate-100 bg-slate-50/70 px-5 py-4 dark:border-slate-700/70 dark:bg-slate-900/30 xl:border-l xl:border-t-0">
              <h2 class="mb-3 text-xs font-bold uppercase tracking-wide text-slate-400">Resumen financiero</h2>
              <dl class="space-y-2 text-sm">
                <div class="flex justify-between gap-4"><dt class="text-slate-500">Venta bruta</dt><dd class="font-semibold text-slate-800 dark:text-slate-100">{money(order.totalAmount)}</dd></div>
                <div class="flex justify-between gap-4"><dt class="text-slate-500">Comisión ML</dt><dd class="font-medium text-rose-600">− {money(order.mlCommissionAmount)}</dd></div>
                {Number(order.shippingSellerCost || 0) > 0 && <div class="flex justify-between gap-4"><dt class="text-slate-500">Costo Mercado Envíos</dt><dd class="font-medium text-rose-600">− {money(order.shippingSellerCost)}</dd></div>}
                {Number(order.mpFeeAmount || 0) > 0 && <div class="flex justify-between gap-4"><dt class="text-slate-500">Comisión MP</dt><dd class="font-medium text-rose-600">− {money(order.mpFeeAmount)}</dd></div>}
                <div class="flex justify-between gap-4"><dt class="text-slate-500">Impuestos / IIBB</dt><dd class="font-medium text-orange-600">− {money(order.taxesAmount)}</dd></div>
                <div class="mt-3 flex justify-between gap-4 border-t border-slate-200 pt-3 dark:border-slate-700"><dt class="font-semibold text-slate-700 dark:text-slate-200">Neto ML</dt><dd class="text-base font-bold text-emerald-600">{money(order.netAmount)}</dd></div>
              </dl>
              {order.internalOrderId && <a href="/admin/costs/dashboard?channel=mercadolibre" class="mt-4 inline-flex w-full items-center justify-center rounded-lg border border-indigo-200 bg-white px-3 py-2 text-xs font-bold text-indigo-600 hover:bg-indigo-50 dark:border-indigo-800 dark:bg-slate-800">Ver rentabilidad completa</a>}
            </aside>
          </div>
        </article>
      ))}

      <div id="emptyFilter" class="hidden rounded-xl border border-dashed border-slate-300 bg-white px-6 py-12 text-center dark:border-slate-700 dark:bg-slate-800">
        <div class="font-semibold text-slate-700 dark:text-slate-200">No hay órdenes para este filtro</div>
        <p class="mt-1 text-sm text-slate-500">Probá con otra búsqueda o volvé a mostrar todas.</p>
      </div>
    </div>
  </div>

  <div id="linkModal" class="fixed inset-0 z-50 hidden items-center justify-center bg-slate-900/60 p-4" role="dialog" aria-modal="true" aria-labelledby="linkModalTitle">
    <div class="w-full max-w-xl rounded-2xl bg-white shadow-2xl dark:bg-slate-800">
      <div class="flex items-start justify-between border-b border-slate-200 px-6 py-5 dark:border-slate-700">
        <div class="pr-5">
          <div class="text-xs font-bold uppercase tracking-wide text-indigo-500">Vincular publicación</div>
          <h2 id="linkModalTitle" class="mt-1 text-lg font-bold text-slate-800 dark:text-slate-100">Seleccionar producto interno</h2>
          <p id="linkItemTitle" class="mt-1 text-sm text-slate-500"></p>
        </div>
        <button id="closeLinkModal" type="button" class="rounded-lg p-2 text-slate-400 hover:bg-slate-100 dark:hover:bg-slate-700" aria-label="Cerrar">✕</button>
      </div>
      <form id="linkForm" class="space-y-5 px-6 py-5">
        <div>
          <label for="productSearch" class="mb-1.5 block text-sm font-medium text-slate-700 dark:text-slate-200">Buscar en el catálogo</label>
          <input id="productSearch" type="search" class="form-input w-full rounded-lg border-slate-200 dark:border-slate-700 dark:bg-slate-900" placeholder="Nombre o SKU del producto…" autocomplete="off" />
        </div>
        <div>
          <label for="linkProduct" class="mb-1.5 block text-sm font-medium text-slate-700 dark:text-slate-200">Producto interno</label>
          <select id="linkProduct" required class="form-select w-full rounded-lg border-slate-200 dark:border-slate-700 dark:bg-slate-900">
            <option value="">Seleccioná un producto</option>
            {productCatalog.map((product) => <option value={product.id} data-search={`${product.name} ${product.sku || ''}`.toLocaleLowerCase('es-AR')}>{product.name}{product.sku ? ` · ${product.sku}` : ''}</option>)}
          </select>
          <p id="productSearchEmpty" class="mt-1 hidden text-xs text-amber-600">No encontramos productos con esa búsqueda.</p>
        </div>
        <div>
          <label for="packQuantity" class="mb-1.5 block text-sm font-medium text-slate-700 dark:text-slate-200">Unidades internas por cada venta de ML</label>
          <input id="packQuantity" type="number" min="1" step="1" value="1" required class="form-input w-full rounded-lg border-slate-200 dark:border-slate-700 dark:bg-slate-900" />
          <p class="mt-1 text-xs text-slate-500">Ejemplo: si la publicación es un pack de 25 unidades, ingresá 25.</p>
        </div>
        <div class="rounded-lg bg-indigo-50 p-3 text-xs text-indigo-700 dark:bg-indigo-900/20 dark:text-indigo-300">Al guardar se reprocesarán automáticamente las órdenes pendientes de esta publicación. No se duplicarán ventas existentes.</div>
        <div id="linkError" class="hidden rounded-lg bg-rose-50 p-3 text-sm text-rose-700 dark:bg-rose-900/20 dark:text-rose-300"></div>
        <div class="flex justify-end gap-2 border-t border-slate-100 pt-4 dark:border-slate-700">
          <button id="cancelLinkModal" type="button" class="btn border-slate-200 bg-white text-slate-600 dark:border-slate-600 dark:bg-slate-700 dark:text-slate-200">Cancelar</button>
          <button id="saveLink" type="submit" class="btn bg-indigo-600 text-white hover:bg-indigo-700">Guardar y reprocesar</button>
        </div>
      </form>
    </div>
  </div>
</AdminLayout>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const searchInput = document.getElementById('orderSearch');
    const filterSelect = document.getElementById('orderFilter');
    const rows = Array.from(document.querySelectorAll('[data-order-row]'));
    const emptyFilter = document.getElementById('emptyFilter');
    const visibleCount = document.getElementById('visibleCount');
    const normalize = (value) => String(value || '').toLocaleLowerCase('es-AR').normalize('NFD').replace(/[\u0300-\u036f]/g, '');
    let financialFilter = '';

    const applyFilters = () => {
      const query = normalize(searchInput?.value);
      const stage = filterSelect?.value || 'all';
      let visible = 0;
      rows.forEach((row) => {
        const show = (!query || normalize(row.dataset.search).includes(query)) && (stage === 'all' || row.dataset.stage === stage) && (!financialFilter || row.dataset.financial === financialFilter);
        row.classList.toggle('hidden', !show);
        if (show) visible += 1;
      });
      emptyFilter?.classList.toggle('hidden', visible > 0 || rows.length === 0);
      if (visibleCount) visibleCount.textContent = `${visible} de ${rows.length} órdenes`;
    };

    searchInput?.addEventListener('input', applyFilters);
    filterSelect?.addEventListener('change', () => { financialFilter = ''; applyFilters(); });
    document.querySelectorAll('[data-quick-filter]').forEach((button) => button.addEventListener('click', () => {
      filterSelect.value = button.dataset.quickFilter;
      financialFilter = '';
      applyFilters();
      document.getElementById('ordersList')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }));
    document.querySelector('[data-financial-filter]')?.addEventListener('click', (event) => {
      filterSelect.value = 'all';
      financialFilter = event.currentTarget.dataset.financialFilter;
      applyFilters();
      document.getElementById('ordersList')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
    });
    document.querySelectorAll('.copy-order').forEach((button) => button.addEventListener('click', async () => {
      await navigator.clipboard.writeText(button.dataset.copy || '');
      button.classList.add('text-emerald-500');
      window.setTimeout(() => button.classList.remove('text-emerald-500'), 900);
    }));

    const modal = document.getElementById('linkModal');
    const linkForm = document.getElementById('linkForm');
    const linkItemTitle = document.getElementById('linkItemTitle');
    const productSelect = document.getElementById('linkProduct');
    const productSearch = document.getElementById('productSearch');
    const productSearchEmpty = document.getElementById('productSearchEmpty');
    const packQuantity = document.getElementById('packQuantity');
    const linkError = document.getElementById('linkError');
    const saveLink = document.getElementById('saveLink');
    let currentItem = null;

    const closeModal = () => {
      modal?.classList.add('hidden');
      modal?.classList.remove('flex');
      document.body.classList.remove('overflow-hidden');
      currentItem = null;
    };
    const openModal = (button) => {
      currentItem = { meliItemId: button.dataset.meliItemId, meliVariationId: button.dataset.variationId || null };
      linkItemTitle.textContent = button.dataset.itemTitle || '';
      productSelect.value = button.dataset.productId || '';
      packQuantity.value = button.dataset.packQuantity || '1';
      productSearch.value = '';
      Array.from(productSelect.options).forEach((option) => option.hidden = false);
      productSearchEmpty.classList.add('hidden');
      linkError.classList.add('hidden');
      modal.classList.remove('hidden');
      modal.classList.add('flex');
      document.body.classList.add('overflow-hidden');
      window.setTimeout(() => productSearch.focus(), 50);
    };
    document.querySelectorAll('.link-item-btn').forEach((button) => button.addEventListener('click', () => openModal(button)));
    document.getElementById('closeLinkModal')?.addEventListener('click', closeModal);
    document.getElementById('cancelLinkModal')?.addEventListener('click', closeModal);
    modal?.addEventListener('click', (event) => { if (event.target === modal) closeModal(); });
    document.addEventListener('keydown', (event) => { if (event.key === 'Escape' && !modal?.classList.contains('hidden')) closeModal(); });

    productSearch?.addEventListener('input', () => {
      const query = normalize(productSearch.value);
      let matches = 0;
      Array.from(productSelect.options).forEach((option, index) => {
        if (index === 0) return;
        const show = !query || normalize(option.dataset.search).includes(query);
        option.hidden = !show;
        if (show) matches += 1;
      });
      productSearchEmpty.classList.toggle('hidden', matches > 0);
    });

    linkForm?.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (!currentItem || !productSelect.value) return;
      const originalText = saveLink.textContent;
      saveLink.disabled = true;
      saveLink.textContent = 'Guardando…';
      linkError.classList.add('hidden');
      try {
        const response = await fetch('/api/meli/link-listing', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ ...currentItem, productId: productSelect.value, packQuantity: Number(packQuantity.value) || 1, syncEnabled: true }),
        });
        const result = await response.json();
        if (!response.ok || !result.success) throw new Error(result.error || 'No se pudo guardar el vínculo');
        saveLink.textContent = result.reprocessErrors
          ? `Guardado · ${result.reprocessedOrders || 0} actualizadas, ${result.reprocessErrors} con error`
          : `Listo · ${result.reprocessedOrders || 0} reprocesadas`;
        window.setTimeout(() => window.location.reload(), 650);
      } catch (error) {
        linkError.textContent = error.message || 'No se pudo guardar el vínculo';
        linkError.classList.remove('hidden');
        saveLink.disabled = false;
        saveLink.textContent = originalText;
      }
    });

    document.getElementById('btnResolveNext')?.addEventListener('click', () => {
      filterSelect.value = 'needs_link';
      financialFilter = '';
      applyFilters();
      document.querySelector('[data-order-row]:not(.hidden) .link-item-btn')?.click();
    });

    const importButton = document.getElementById('btnImport');
    importButton?.addEventListener('click', async () => {
      const original = importButton.innerHTML;
      importButton.textContent = 'Importando…';
      importButton.disabled = true;
      try {
        const response = await fetch('/api/meli/import-orders', { method: 'POST' });
        const result = await response.json();
        if (!response.ok || !result.success) throw new Error(result.error || 'No se pudieron importar las órdenes');
        alert(`Importación terminada: ${result.data.imported} nuevas, ${result.data.updated || 0} actualizadas, ${result.data.unmatched || 0} sin vincular y ${result.data.errors} errores.`);
        window.location.reload();
      } catch (error) {
        alert(error.message || 'Error importando órdenes');
        importButton.innerHTML = original;
        importButton.disabled = false;
      }
    });

    const reconcileButton = document.getElementById('btnReconcile');
    reconcileButton?.addEventListener('click', async () => {
      const original = reconcileButton.textContent;
      reconcileButton.textContent = 'Conciliando…';
      reconcileButton.disabled = true;
      try {
        const response = await fetch('/api/meli/reconcile', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: '{}' });
        const result = await response.json();
        if (!response.ok) throw new Error(result.error || 'No se pudieron consultar los cargos facturados');
        alert(`Conciliación terminada: ${result.data.reconciled} órdenes conciliadas, ${result.data.partial || 0} con información parcial para reintentar y ${result.data.skipped} todavía sin detalle de facturación.`);
        window.location.reload();
      } catch (error) {
        alert(error.message || 'Error conciliando cargos');
        reconcileButton.textContent = original;
        reconcileButton.disabled = false;
      }
    });
    applyFilters();
  });
</script>
