                                                                                            <div class={`row-subtotal text-[10px] font-black text-rose-500 bg-rose-50 px-1.5 py-0.5 rounded border border-rose-100 ${isChildChecked ? '' : 'hidden'}`} data-id={child.id}>
                                                                                                $0.00
