    function attachVariantImagePreview(input) {
        if (!input) return;
        input.addEventListener('change', (e) => {
            const files = e.target.files;
            if (!files || files.length === 0) return;
            
            const idx = input.getAttribute('data-idx');
            const previewContainer = input.closest('.variant-images-preview');

            for (let i = 0; i < files.length; i++) {
                const file = files[i];
                const reader = new FileReader();
                reader.onloadend = () => {
                    const div = document.createElement('div');
                    div.className = 'relative group/img w-10 h-10';
                    div.innerHTML = `
                        <img src="${reader.result}" class="w-10 h-10 object-cover rounded-lg border border-indigo-200" />
                        <div class="absolute inset-0 flex items-center justify-center bg-black/20 opacity-0 group-hover/img:opacity-100 transition-opacity rounded-lg">
                            <button type="button" class="remove-variant-new-img bg-rose-500 text-white rounded-full p-0.5">
                                <svg xmlns="http://www.w3.org/2000/svg" width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
                            </button>
                        </div>
                    `;
                    // Insert before the label (the plus button)
                    previewContainer.insertBefore(div, input.parentElement);
                };
                reader.readAsDataURL(file);
            }
        });
    }

    function removeNewImage(id) {
         const el = document.getElementById(id);
         if (el) el.remove();
    }

    function removeExistingImage(id) {
        const el = document.getElementById(id);
        if (el) el.remove();
    }

    function getDragAfterElement(container, y, x) {
        const draggableElements = [...container.querySelectorAll('.existing-image-item:not(.dragging)')];
        return draggableElements.reduce((closest, child) => {
            const box = child.getBoundingClientRect();
            const offset = y - box.top - box.height / 2;
             if (offset < 0 && offset > closest.offset) {
                return { offset: offset, element: child };
            } else {
                return closest;
            }
        }, { offset: Number.NEGATIVE_INFINITY }).element;
    }

    function updateCoverBadge() {
        const items = document.querySelectorAll('.existing-image-item');
        items.forEach((item, index) => {
            const badge = item.querySelector('.cover-badge');
            if (badge) badge.style.opacity = index === 0 ? '1' : '0';
            item.classList.toggle('ring-2', index === 0);
            item.classList.toggle('ring-indigo-600', index === 0);
        });
    }

    async function handleSubmit(event) {
        event.preventDefault();
        const form = event.target;
        const formData = new FormData(form);
        
        // Collect variants
        const variants = [];
        document.querySelectorAll('.variant-item').forEach((item, index) => {
            const id = item.querySelector(`input[name^="variant_id_"]`)?.value;
            const name = item.querySelector(`input[name^="variant_name_"]`)?.value;
            const sku = item.querySelector(`input[name^="variant_sku_"]`)?.value;
            const price = item.querySelector(`input[name^="variant_price_"]`)?.value;
            const stock = item.querySelector(`input[name^="variant_stock_"]`)?.value;
            const existingImagesStr = item.querySelector(`input[name^="variant_existing_images_"]`)?.value;
            const existingImages = existingImagesStr ? JSON.parse(existingImagesStr) : [];
            
            const imageInput = item.querySelector(`.variant-image-input`);
            const files = imageInput ? imageInput.files : [];
            
            if (name) {
                const imageFieldNames = [];
                if (files && files.length > 0) {
                    for (let i = 0; i < files.length; i++) {
                        const fieldName = `variant_file_${index}_${i}_${Date.now()}`;
                        formData.append(fieldName, files[i]);
                        imageFieldNames.push(fieldName);
                    }
                }

                variants.push({ 
                    id: id || null, 
                    name, 
                    sku: sku || null, 
                    price: price ? parseFloat(price) : null, 
                    stock: parseInt(stock) || 0,
                    existingImages: existingImages,
                    imageFieldNames: imageFieldNames
                });
            }
        });
        formData.append('variants_json', JSON.stringify(variants));
        
        const isActiveEl = document.getElementById('isActive');
        const isFeaturedEl = document.getElementById('isFeatured');
        if (isActiveEl) formData.set('isActive', isActiveEl.checked ? 'true' : 'false');
        if (isFeaturedEl) formData.set('isFeatured', isFeaturedEl.checked ? 'true' : 'false');
        
        const meliIdVal = document.getElementById('meliItemId')?.value;
        if(meliIdVal) formData.set('meliItemId', meliIdVal);

        const method = isNew ? 'POST' : 'PUT';
        const url = isNew ? '/api/products' : `/api/products/${id}`;

        const saveBtns = document.querySelectorAll('.save-btn');
        const saveSpinners = document.querySelectorAll('.save-spinner');
        const saveIcons = document.querySelectorAll('.save-icon');
        const saveTexts = document.querySelectorAll('.save-text');

        // Loading state
        saveBtns.forEach(btn => btn.disabled = true);
        saveSpinners.forEach(s => s.classList.remove('hidden'));
        saveIcons.forEach(i => i.classList.add('hidden'));
        saveTexts.forEach(t => t.textContent = 'Guardando...');

        try {
            const response = await fetch(url, { method: method, body: formData });
            if (response.ok) {
                // ... rest of the code
                const data = await response.json();
                const productId = isNew ? data.id : id;

                // Save production time rules as a separate call
                const timeRules = [];
                document.querySelectorAll('.time-rule-item').forEach((item) => {
                    const minQ = item.querySelector(`input[name^="time_rule_min_"]`)?.value;
                    const maxQ = item.querySelector(`input[name^="time_rule_max_"]`)?.value;
                    const time = item.querySelector(`input[name^="time_rule_time_"]`)?.value;
                    if (minQ && time) {
                        timeRules.push({
                            minQuantity: parseInt(minQ),
                            maxQuantity: maxQ ? parseInt(maxQ) : null,
                            productionTime: time,
                        });
                    }
                });

                const timeResp = await fetch(`/api/products/${productId}/production-time-rules`, {
                    method: 'PUT',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ rules: timeRules }),
                });

                // Save price rules as a separate call
                const priceRulesData = [];
                document.querySelectorAll('.price-rule-item').forEach((item) => {
                    const minQ = item.querySelector(`input[name^="price_rule_min_"]`)?.value;
                    const maxQ = item.querySelector(`input[name^="price_rule_max_"]`)?.value;
                    const pct = item.querySelector(`input[name^="price_rule_pct_"]`)?.value;
                    if (minQ && pct) {
                        priceRulesData.push({
                            minQuantity: parseInt(minQ),
                            maxQuantity: maxQ ? parseInt(maxQ) : null,
                            discountPercentage: pct,
                        });
                    }
                });

                const priceResp = await fetch(`/api/products/${productId}/price-rules`, {
                    method: 'PUT',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ rules: priceRulesData }),
                });

                // --- SAVE COSTOS E INSUMOS ---
                const selectedSupplies = Array.from(document.querySelectorAll('.supply-checkbox'))
                    .filter(cb => cb.checked)
                    .map(cb => {
                        const supplyId = cb.value;
                        const yieldCont = document.querySelector(`.yield-container[data-id="${supplyId}"]`);
                        const isYield = yieldCont && !yieldCont.classList.contains('hidden');
                        
                        if (isYield) {
                            const used = parseFloat(yieldCont.querySelector('.yield-used').value) || 0;
                            const total = parseFloat(yieldCont.querySelector('.yield-total').value) || 1;
                            return {
                                supplyId: parseInt(supplyId),
                                quantity: used / total,
                                partsUsed: used,
                                partsTotal: total
                            };
                        } else {
                            const qtyInput = document.querySelector(`.supply-qty[data-id="${supplyId}"]`);
                            return {
                                supplyId: parseInt(supplyId),
                                quantity: parseFloat(qtyInput?.value) || 0,
                                partsUsed: null,
                                partsTotal: null
                            };
                        }
                    });

                await fetch(`/api/products/${productId}/supplies`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ supplies: selectedSupplies })
                });
                // --- FIN SAVE COSTOS E INSUMOS ---

                if (!timeResp.ok) {
                    const errData = await timeResp.json().catch(() => ({}));
                    if(window.showToast) window.showToast('Producto guardado, pero error en reglas de tiempo: ' + (errData.error || 'Error desconocido'), 'error');
                    else alert('Producto guardado, pero error en reglas de tiempo: ' + (errData.error || 'Error desconocido'));
                } else {
                    if(window.showToast) window.showToast('Producto guardado correctamente', 'success');
                    else alert('Producto guardado correctamente');
                }

                // Success state
                saveTexts.forEach(t => t.textContent = '¡Guardado!');
                setTimeout(() => {
                    if (isNew && data.id) window.location.href = `/admin/products/${data.id}`;
                    else window.location.reload();
                }, 1000);
            } else {
                const text = await response.text();
                alert('Error al guardar: ' + text);
                // Reset loading state
                saveBtns.forEach(btn => btn.disabled = false);
                saveSpinners.forEach(s => s.classList.add('hidden'));
                saveIcons.forEach(i => i.classList.remove('hidden'));
                saveTexts.forEach((t, i) => t.textContent = i === 0 ? 'Guardar Cambios' : 'Guardar');
            }
        } catch (error) {
            console.error(error);
            alert('Error de red al guardar el producto');
            // Reset loading state
            saveBtns.forEach(btn => btn.disabled = false);
            saveSpinners.forEach(s => s.classList.add('hidden'));
            saveIcons.forEach(i => i.classList.remove('hidden'));
            saveTexts.forEach((t, i) => t.textContent = i === 0 ? 'Guardar Cambios' : 'Guardar');
        }
    }

    // --- COSTOS E INSUMOS LOGIC ---
    const supplyCheckboxes = document.querySelectorAll('.supply-checkbox');
    const supplyQtys = document.querySelectorAll('.supply-qty');
    const yieldToggles = document.querySelectorAll('.yield-toggle');
    const yieldUseds = document.querySelectorAll('.yield-used');
    const yieldTotals = document.querySelectorAll('.yield-total');
    
    // UI Calculation els
    const calcBase = document.getElementById('calc-base');
    const calcCosts = document.getElementById('calc-costs');
    const calcMargin = document.getElementById('calc-margin');
    const calcPercent = document.getElementById('calc-percent');

    function recalculateImpact() {
        const bpValue = parseFloat(document.getElementById('basePrice').value) || 0;
        let totalCost = 0;
        
        const topInsumosList = document.getElementById('top-insumos-list');
        const topGlobalList = document.getElementById('top-global-costs-list');
        
        if (topInsumosList) topInsumosList.innerHTML = '';
        if (topGlobalList) topGlobalList.innerHTML = '';

        // 1. Fixed and Percentage Costs (Global/Linked)
        const calcCard = document.getElementById('product-calc-card');
        if (calcCard && calcCard.dataset.costs) {
            try {
                const activeCosts = JSON.parse(calcCard.dataset.costs);
                activeCosts.forEach(cost => {
                    let costVal = 0;
                    if (cost.type === 'percentage') {
                        costVal = (bpValue * (cost.value / 100));
                    } else {
                        costVal = Number(cost.value);
                    }
                    totalCost += costVal;
                    
                    if (topGlobalList && costVal > 0) {
                        topGlobalList.innerHTML += `<span class="inline-flex items-center px-1.5 py-0.5 rounded text-[10px] font-bold bg-indigo-100 text-indigo-700">${cost.name}: $${costVal.toLocaleString('es-AR', {minimumFractionDigits: 2, maximumFractionDigits: 2})}</span>`;
                    }
                });
            } catch(e) {}
        }

        // 2. Supplies
        supplyCheckboxes.forEach(cb => {
            if (cb.checked) {
                const supplyId = cb.value;
                const unitCost = parseFloat(cb.getAttribute('data-cost')) || 0;
                const name = cb.getAttribute('data-name');
                
                const yieldContainer = document.querySelector(`.yield-container[data-id="${supplyId}"]`);
                const subtotalEl = document.querySelector(`.row-subtotal[data-id="${supplyId}"]`);
                let qty = 0;
                
                if (yieldContainer && !yieldContainer.classList.contains('hidden')) {
                    const used = parseFloat(yieldContainer.querySelector('.yield-used').value) || 0;
                    const total = parseFloat(yieldContainer.querySelector('.yield-total').value) || 1;
                    qty = used / total;
                } else {
                    const qtyInput = document.querySelector(`.supply-qty[data-id="${supplyId}"]`);
                    qty = parseFloat(qtyInput?.value) || 0;
                }
                
                const subtotal = unitCost * qty;
                totalCost += subtotal;

                if (subtotalEl) {
                    if (qty > 0) {
                        subtotalEl.textContent = `$${subtotal.toLocaleString('es-AR', {minimumFractionDigits: 2, maximumFractionDigits: 2})}`;
                        subtotalEl.classList.remove('hidden');
                    } else {
                        subtotalEl.classList.add('hidden');
                    }
                }

                if (topInsumosList && subtotal > 0) {
                    topInsumosList.innerHTML += `<span class="inline-flex items-center px-1.5 py-0.5 rounded text-[10px] font-bold bg-rose-100 text-rose-700">${name}: $${subtotal.toLocaleString('es-AR', {minimumFractionDigits: 2, maximumFractionDigits: 2})}</span>`;
                }
            } else {
                const subtotalEl = document.querySelector(`.row-subtotal[data-id="${cb.value}"]`);
                if (subtotalEl) subtotalEl.classList.add('hidden');
            }
        });
        
        if (topInsumosList && topInsumosList.innerHTML === '') {
            topInsumosList.innerHTML = `<span class="text-[10px] text-gray-400 italic">No hay insumos seleccionados</span>`;
        }
        if (topGlobalList && topGlobalList.innerHTML === '') {
            topGlobalList.innerHTML = `<span class="text-[10px] text-gray-400 italic">No hay costos globales</span>`;
        }

        const margin = bpValue - totalCost;
        const roi = bpValue > 0 ? ((margin / bpValue) * 100).toFixed(1) : 0;

        if (calcCosts) calcCosts.textContent = `$${totalCost.toLocaleString('es-AR', {minimumFractionDigits: 2, maximumFractionDigits: 2})}`;
        
        const netPriceEl = document.getElementById('netPrice');
        if (netPriceEl && document.activeElement !== netPriceEl && document.activeElement !== document.getElementById('basePrice')) {
            netPriceEl.value = margin.toFixed(2);
        }
        if (calcMargin) {
            calcMargin.textContent = `$${margin.toLocaleString('es-AR', {minimumFractionDigits: 2, maximumFractionDigits: 2})}`;
            calcMargin.parentElement.className = margin >= 0 ? "flex items-center gap-1.5 text-emerald-600" : "flex items-center gap-1.5 text-rose-600";
        }
        if (calcPercent) {
            calcPercent.textContent = `${roi}%`;
            calcPercent.className = margin >= 0 ? "text-xs bg-emerald-100 px-1.5 py-0.5 rounded" : "text-xs bg-rose-100 px-1.5 py-0.5 rounded";
        }
    }

    document.getElementById('basePrice')?.addEventListener('input', recalculateImpact);

    supplyCheckboxes.forEach(cb => {
        cb.addEventListener('change', (e) => {
            const supplyId = e.target.value;
            const isChecked = e.target.checked;
            
            // Enable/disable inputs and auto-fill 1 if empty
            const qtyInput = document.querySelector(`.supply-qty[data-id="${supplyId}"]`);
            const yieldUsed = document.querySelector(`.yield-used[data-id="${supplyId}"]`);
            const yieldTotal = document.querySelector(`.yield-total[data-id="${supplyId}"]`);
            
            if(qtyInput) {
                qtyInput.disabled = !isChecked;
                if (isChecked && (!qtyInput.value || parseFloat(qtyInput.value) === 0)) qtyInput.value = 1;
            }
            if(yieldUsed) {
                yieldUsed.disabled = !isChecked;
                if (isChecked && (!yieldUsed.value || parseFloat(yieldUsed.value) === 0)) yieldUsed.value = 1;
            }
            if(yieldTotal) {
                yieldTotal.disabled = !isChecked;
                if (isChecked && (!yieldTotal.value || parseFloat(yieldTotal.value) === 0)) yieldTotal.value = 1;
            }

            recalculateImpact();
        });
    });

    supplyQtys.forEach(input => input.addEventListener('input', recalculateImpact));
    yieldUseds.forEach(input => input.addEventListener('input', recalculateImpact));
    yieldTotals.forEach(input => input.addEventListener('input', recalculateImpact));

    yieldToggles.forEach(btn => {
        btn.addEventListener('click', (e) => {
            const id = e.currentTarget.getAttribute('data-id');
            const qtyCont = document.querySelector(`.qty-container[data-id="${id}"]`);
            const yieldCont = document.querySelector(`.yield-container[data-id="${id}"]`);
            
            const isYield = qtyCont.classList.contains('hidden');
            
            if (isYield) {
                qtyCont.classList.remove('hidden');
                yieldCont.classList.add('hidden');
                e.currentTarget.classList.remove('text-indigo-600', 'bg-indigo-50');
                e.currentTarget.classList.add('text-gray-400');
            } else {
                qtyCont.classList.add('hidden');
                yieldCont.classList.remove('hidden');
                e.currentTarget.classList.add('text-indigo-600', 'bg-indigo-50');
                e.currentTarget.classList.remove('text-gray-400');
            }
            recalculateImpact();
        });
    });

    // SUPPLY CATEGORY TABS LOGIC
    document.querySelectorAll('.supply-tab-btn').forEach(btn => {
        btn.addEventListener('click', (e) => {
            const cat = e.currentTarget.getAttribute('data-category');
            
            document.querySelectorAll('.supply-tab-btn').forEach(b => {
                b.classList.remove('bg-indigo-600', 'text-white', 'border-indigo-600', 'shadow-sm');
                b.classList.add('bg-white', 'text-gray-500', 'border-gray-200');
            });
            e.currentTarget.classList.remove('bg-white', 'text-gray-500', 'border-gray-200');
            e.currentTarget.classList.add('bg-indigo-600', 'text-white', 'border-indigo-600', 'shadow-sm');

            document.querySelectorAll('.supply-group').forEach(group => {
                const isChild = group.dataset.isChild === 'true';
                if (cat === 'ALL') {
                    if (isChild) {
                        group.classList.add('hidden');
                    } else {
                        group.classList.remove('hidden');
                    }
                } else {
                    if (group.dataset.category === cat) {
                        group.classList.remove('hidden');
                    } else {
                        group.classList.add('hidden');
                    }
                }
            });
        });
    });

    // Expand/Collapse Logic for linking section
    document.querySelectorAll('.supply-item-row[data-has-children="true"]').forEach(row => {
        row.addEventListener('click', (e) => {
            if (e.target.closest('input') || e.target.closest('button')) return;
            
            const id = row.getAttribute('data-id');
            const list = document.querySelector(`.children-list[data-parent-of-list="${id}"]`);
            const chevron = row.querySelector('.chevron-icon');
            
            if (list) {
                const isHidden = list.classList.contains('hidden');
                if (isHidden) {
                    list.classList.remove('hidden');
                    if (chevron) chevron.style.transform = 'rotate(90deg)';
                } else {
                    list.classList.add('hidden');
                    if (chevron) chevron.style.transform = 'rotate(0deg)';
                }
            }
        });
    });

    // Initial calculation
    document.addEventListener('DOMContentLoaded', () => {
        recalculateImpact();
    });
    // --- FIN COSTOS E INSUMOS LOGIC ---
</script>

