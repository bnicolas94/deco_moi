                                                                            <input type="number" placeholder="Total" value={hasYield ? linked.partsTotal : ''} data-id={s.id} class="yield-total w-12 h-7 bg-white rounded border-indigo-100 text-[11px] font-bold text-center focus:ring-indigo-500 focus:border-indigo-500 disabled:opacity-50" disabled={!isChecked} />
                                                                        </div>
                                                                    </div>
                                                                </div>
                                                            </div>

                                                            {hasChildren && (
