                                    variants.map((v: any, idx: number) => (
                                        <div class="variant-item grid grid-cols-1 md:grid-cols-12 gap-4 p-4 bg-gray-50/50 rounded-2xl border border-gray-100 relative group animate-in fade-in slide-in-from-top-2">
                                            <input type="hidden" name={`variant_id_${idx}`} value={v.id} />
                                            <input type="hidden" name={`variant_existing_images_${idx}`} value={JSON.stringify(v.images || [])} />
                                            <div class="md:col-span-3">
                                                <label class="block text-[10px] font-bold text-gray-400 uppercase mb-1">Nombre / Atributos</label>
                                                <input type="text" name={`variant_name_${idx}`} value={v.name} placeholder="Ej: Rojo / XL" class="w-full rounded-lg border-gray-200 text-sm h-10 border px-3 focus:ring-indigo-500" required />
                                            </div>
                                            <div class="md:col-span-2">
                                                <label class="block text-[10px] font-bold text-gray-400 uppercase mb-1">SKU</label>
                                                <input type="text" name={`variant_sku_${idx}`} value={v.sku} placeholder="SKU Único" class="w-full rounded-lg border-gray-200 text-sm h-10 border px-3 focus:ring-indigo-500" />
                                            </div>
                                            <div class="md:col-span-2">
                                                <label class="block text-[10px] font-bold text-gray-400 uppercase mb-1">Precio Opc.</label>
                                                <input type="number" step="0.01" name={`variant_price_${idx}`} value={v.price} placeholder="Base" class="w-full rounded-lg border-gray-200 text-sm h-10 border px-3 focus:ring-indigo-500" />
                                            </div>
                                            <div class="md:col-span-1">
                                                <label class="block text-[10px] font-bold text-gray-400 uppercase mb-1">Stock</label>
                                                <input type="number" name={`variant_stock_${idx}`} value={v.stock} class="w-full rounded-lg border-gray-200 text-sm h-10 border px-3 focus:ring-indigo-500" required />
                                            </div>
                                            <div class="md:col-span-3">
                                                <label class="block text-[10px] font-bold text-gray-400 uppercase mb-1">Imágenes Varias</label>
                                                <div class="flex flex-wrap gap-2 mb-2 variant-images-preview" data-idx={idx}>
                                                    {(v.images || []).map((img: any, imgIdx: number) => (
                                                        <div class="relative group/img w-10 h-10">
                                                            <img src={img} class="w-10 h-10 object-cover rounded-lg border border-gray-200" alt={v.name} />
                                                            <button type="button" class="remove-variant-existing-img absolute -top-1 -right-1 bg-rose-500 text-white rounded-full p-0.5 opacity-0 group-hover/img:opacity-100 transition-opacity z-10" data-idx={idx} data-img-idx={imgIdx}>
                                                                <Plus className="w-2.5 h-2.5 rotate-45" />
                                                            </button>
                                                        </div>
                                                    ))}
                                                    <label class="w-10 h-10 rounded-lg border-2 border-dashed border-gray-200 flex items-center justify-center cursor-pointer hover:border-indigo-400 hover:bg-indigo-50 transition-all">
                                                        <Plus className="w-4 h-4 text-gray-300" />
                                                        <input type="file" accept="image/*" name={`variant_images_${idx}`} multiple class="hidden variant-image-input" data-idx={idx} />
                                                    </label>
                                                </div>
                                            </div>
                                            <div class="md:col-span-1 flex items-end justify-center pb-1">
                                                <button type="button" class="remove-variant-btn p-2 text-rose-400 hover:text-rose-600 hover:bg-rose-50 rounded-lg transition-colors">
                                                    <Trash2 className="w-4 h-4" />
                                                </button>
                                            </div>
                                        </div>
                                    ))
                                )}
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="lg:col-span-4 space-y-8">
                <!-- Status & Template -->
                <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-6 space-y-6">
                    <div class="space-y-4">
                        <label class="flex items-center group cursor-pointer">
                            <div class="relative flex items-center">
                                <input 
                                    type="checkbox" 
                                    id="isActive"
                                    name="isActive" 
                                    checked={isNew ? true : product?.isActive} 
                                    value="true"
                                    class="sr-only peer"
                                />
                                <div class="w-11 h-6 bg-gray-200 peer-focus:outline-none peer-focus:ring-4 peer-focus:ring-indigo-300 rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-5 after:width-5 after:transition-all peer-checked:bg-indigo-600"></div>
                                <span class="ml-3 text-sm font-bold text-gray-700 group-hover:text-gray-900 transition-colors">Producto Activo</span>
                            </div>
                        </label>
                        
                        <label class="flex items-center group cursor-pointer">
                            <div class="relative flex items-center">
                                <input 
                                    type="checkbox" 
                                    id="isFeatured"
                                    name="isFeatured" 
                                    checked={product?.isFeatured} 
                                    value="true"
                                    class="sr-only peer"
                                />
                                <div class="w-11 h-6 bg-gray-200 peer-focus:outline-none peer-focus:ring-4 peer-focus:ring-indigo-300 rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-5 after:width-5 after:transition-all peer-checked:bg-amber-400"></div>
                                <span class="ml-3 text-sm font-bold text-gray-700 group-hover:text-gray-900 transition-colors flex items-center gap-1.5 focus:ring-amber-500">
                                    <Star className={`w-4 h-4 ${product?.isFeatured ? 'fill-amber-400 text-amber-400' : 'text-gray-400'}`} />
                                    Destacado
                                </span>
                            </div>
                        </label>
                        
                        <label class="flex items-center group cursor-pointer">
                            <div class="relative flex items-center">
                                <input 
                                    type="checkbox" 
                                    id="showDiscountRanges"
                                    name="showDiscountRanges" 
                                    checked={isNew ? true : product?.showDiscountRanges} 
                                    value="true"
                                    class="sr-only peer"
                                />
                                <div class="w-11 h-6 bg-gray-200 peer-focus:outline-none peer-focus:ring-4 peer-focus:ring-emerald-300 rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-5 after:width-5 after:transition-all peer-checked:bg-emerald-500"></div>
                                <span class="ml-3 text-sm font-bold text-gray-700 group-hover:text-gray-900 transition-colors flex items-center gap-1.5 focus:ring-emerald-500">
                                    Mostrar tabla de descuentos
                                </span>
                            </div>
                        </label>
                    </div>

                    <div class="space-y-2 pt-4 border-t border-gray-50">
                        <label class="block text-sm font-bold text-gray-700">Categoría</label>
                        <select 
                            name="categoryId" 
                            required
                            class="block w-full rounded-xl border-gray-200 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm h-11 border px-3 bg-white transition-all"
                        >
                            <option value="">Seleccionar categoría...</option>
                            {allCategories.map(cat => (
                                <option value={cat.id} selected={product?.categoryId === cat.id}>{cat.name}</option>
                            ))}
                        </select>
                    </div>

                    <div class="space-y-2">
                        <label class="block text-sm font-bold text-gray-700">Plantilla Mockup</label>
                        <select 
                            name="mockupTemplateId" 
                            class="block w-full rounded-xl border-gray-200 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm h-11 border px-3 bg-white transition-all"
                        >
                            <option value="">Sin plantilla</option>
                            {allTemplates.map(template => (
                                <option value={template.id} selected={product?.mockupTemplateId === template.id}>
                                    {template.name}
                                </option>
                            ))}
                        </select>
                    </div>
                </div>

                <!-- Images Management -->
                <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-6 space-y-6">
                    <div class="flex items-center justify-between">
                        <h3 class="text-sm font-bold text-gray-900 flex items-center gap-2">
                            <ImageIcon className="w-4 h-4 text-indigo-500" />
                            Imágenes del Producto
                        </h3>
                    </div>

                    {/* Drag & Drop Hint */}
                    <p class="text-[10px] text-gray-400 bg-gray-50 p-2 rounded-lg border border-gray-100 flex items-center gap-1.5 line-height-tight">
                         Arrastra para reordenar. La primera imagen será la de portada.
                    </p>

                    <div id="existing-images" class="grid grid-cols-2 gap-3 min-h-[100px]">
                        {currentImages.map((img: any, idx: number) => (
                            <div 
                                id={`img-${idx}`}
                                class="existing-image-item relative group rounded-xl overflow-hidden border border-gray-100 shadow-sm cursor-move transition-all active:scale-95 active:rotate-2 hover:shadow-md h-24"
                                draggable="true"
                            >
                                <input type="hidden" name="existingImages" value={img} />
                                <img src={img} class="w-full h-full object-cover transition-transform group-hover:scale-110" />
                                
                                {/* Image Overlay/Actions */}
                                <div class="absolute inset-0 bg-black/40 opacity-0 group-hover:opacity-100 transition-opacity flex items-center justify-center gap-2">
                                    <button 
                                        type="button" 
                                        class="set-cover-btn p-1.5 bg-white/20 hover:bg-white/40 text-white rounded-lg transition-colors"
                                        title="Hacer portada"
                                    >
                                        <Star className="w-3.5 h-3.5 fill-current" />
                                    </button>
                                    <button 
                                        type="button" 
                                        class="remove-image-btn p-1.5 bg-white/20 hover:bg-rose-500 text-white rounded-lg transition-colors"
                                        title="Eliminar"
                                        data-image-id={`img-${idx}`}
                                        data-is-new="false"
                                    >
                                        <Plus className="w-3.5 h-3.5 rotate-45" />
                                    </button>
                                </div>

                                {/* Cover Badge */}
                                <div class="cover-badge absolute top-1.5 left-1.5 bg-indigo-600 text-white text-[8px] font-black px-1.5 py-0.5 rounded shadow-lg uppercase tracking-wider opacity-0 pointer-events-none transition-opacity">
                                    Portada
                                </div>
                            </div>
                        ))}
                    </div>

                    <label class="relative flex flex-col items-center justify-center py-8 border-2 border-dashed border-gray-200 rounded-2xl cursor-pointer hover:border-indigo-400 hover:bg-indigo-50/30 transition-all group">
                        <div class="flex flex-col items-center justify-center space-y-2">
                            <div class="p-2.5 bg-gray-50 border border-gray-100 rounded-xl group-hover:bg-indigo-50 transition-colors">
                                <Plus className="w-5 h-5 text-gray-400 group-hover:text-indigo-500" />
                            </div>
                        </div>
                        <input 
                            type="file" 
                            name="image" 
                            id="image" 
                            multiple
                            class="hidden" 
                        />
                    </label>

                    <!-- New Images Preview -->
                    <div id="new-images-container" class="grid grid-cols-2 gap-2 mt-4 hidden"></div>
                </div>
            </div>
        </div>
    </form>

    {/* Barra Flotante Inferior */}
    <div id="sticky-save-bar" class="fixed bottom-8 right-8 z-50 translate-y-32 transition-all duration-500">
        <div class="bg-white/80 backdrop-blur-xl border border-gray-200/50 p-2 rounded-3xl shadow-2xl flex items-center gap-4 px-6 min-w-[300px]">
            <div class="flex flex-col">
                <span class="text-[10px] text-gray-400 font-bold uppercase tracking-widest">Edición Rápida</span>
                <span class="text-sm font-bold text-brand-black truncate max-w-[150px]">{product?.name || 'Nuevo Producto'}</span>
            </div>
            <div class="h-8 w-px bg-gray-100 mx-2"></div>
            <button 
                type="submit" 
                form="product-form"
                class="save-btn h-11 px-8 flex items-center gap-2 bg-brand-black text-white font-bold rounded-2xl shadow-lg shadow-brand-black/20 hover:scale-[1.05] active:scale-95 transition-all disabled:opacity-50 disabled:pointer-events-none"
            >
                <div class="save-spinner hidden animate-spin w-4 h-4 border-2 border-white/30 border-t-white rounded-full"></div>
                <Save className="w-5 h-5 save-icon" />
                <span class="save-text">Guardar</span>
            </button>
        </div>
    </div>
</AdminLayout>

<script is:inline define:vars={{ isNew, id: product?.id, allCosts }}>
    // Auto-generate slug from name
    const nameInput = document.getElementById('name');
    const slugInput = document.getElementById('slug');
    
    nameInput?.addEventListener('input', (e) => {
        if (isNew || !slugInput.value) {
            const slug = e.target.value
                .toLowerCase()
                .normalize("NFD").replace(/[\u0300-\u036f]/g, "") // remove accents
                .replace(/[^a-z0-9\s-]/g, '')
                .trim()
                .replace(/\s+/g, '-');
            slugInput.value = slug;
        }
    });

    function getTotalInsumos() {
        let insumosCost = 0;
        document.querySelectorAll('.supply-checkbox').forEach(cb => {
            if (cb.checked) {
                const supplyId = cb.value;
                const unitCost = parseFloat(cb.getAttribute('data-cost')) || 0;
                const yieldContainer = document.querySelector(`.yield-container[data-id="${supplyId}"]`);
                let qty = 0;
                if (yieldContainer && !yieldContainer.classList.contains('hidden')) {
                    const used = parseFloat(yieldContainer.querySelector('.yield-used').value) || 0;
                    const total = parseFloat(yieldContainer.querySelector('.yield-total').value) || 1;
                    qty = used / total;
                } else {
                    const qtyInput = document.querySelector(`.supply-qty[data-id="${supplyId}"]`);
                    qty = parseFloat(qtyInput?.value) || 0;
                }
                insumosCost += (unitCost * qty);
            }
        });
        return insumosCost;
    }

    // --- Reverse Price Logic ---
    const netInput = document.getElementById('netPrice');
    const baseInput = document.getElementById('basePrice');
    
    let totalPerc = 0;
    let totalFixed = 0;
    
    allCosts.forEach(c => {
        if (c.type === 'percentage') {
            totalPerc += c.value;
        } else {
            totalFixed += c.value;
        }
    });

    const calculateGrossFromNet = (net) => {
        if (!net || isNaN(net)) return '';
        if (totalPerc >= 100) return 'Error';
        const gross = (net + totalFixed) / (1 - (totalPerc / 100));
        updateVisualBreakdown(net, gross);
        return parseFloat(gross).toFixed(2);
    };

    const updateVisualBreakdown = (net, gross) => {
        const bdFixedList = document.getElementById('bd-fixed-list');
        const bdPercList = document.getElementById('bd-perc-list');
        
        if (!bdFixedList || !bdPercList) return;
        
        // Populate Fixed Costs
        bdFixedList.innerHTML = '';
        allCosts.filter(c => c.type === 'fixed').forEach(c => {
            const row = document.createElement('div');
            row.className = 'flex items-center justify-between text-gray-600';
            row.innerHTML = `<span>${c.name}</span> <span class="font-bold">$${c.value.toFixed(2)}</span>`;
            bdFixedList.appendChild(row);
        });
        document.getElementById('bd-total-fixed').textContent = `$${totalFixed.toFixed(2)}`;
        
        // Populate Percentages
        bdPercList.innerHTML = '';
        allCosts.filter(c => c.type === 'percentage').forEach(c => {
            const row = document.createElement('div');
            row.className = 'flex items-center justify-between text-gray-600';
            row.innerHTML = `<span>${c.name}</span> <span class="font-bold">${c.value}%</span>`;
            bdPercList.appendChild(row);
        });
        document.getElementById('bd-total-perc').textContent = `${totalPerc.toFixed(2)}%`;
        
        // Update Dynamic Variable Tags and Unified Total Cost
        const dynTags = document.querySelectorAll('.dyn-perc-tag');
        let calculatedVariableTotal = 0;
        dynTags.forEach(tag => {
            const percent = parseFloat(tag.getAttribute('data-percent'));
            const cost = gross * (percent / 100);
            calculatedVariableTotal += cost;
            tag.textContent = `${tag.getAttribute('data-name')}: $${cost.toFixed(2)}`;
        });
        
        const unifiedLabel = document.getElementById('totalUnifiedCostLabel');
        if (unifiedLabel) {
            unifiedLabel.textContent = `$ ${(totalFixed + calculatedVariableTotal).toLocaleString('es-AR', {minimumFractionDigits: 2, maximumFractionDigits: 2})}`;
        }
        
        // Totals
        const investment = net + totalFixed;
        const divisor = 1 - (totalPerc / 100);
        
        document.getElementById('bd-sum-investment').textContent = `$${investment.toLocaleString('es-AR', {minimumFractionDigits: 2, maximumFractionDigits: 2})}`;
        document.getElementById('bd-divisor').textContent = divisor.toFixed(4);
        document.getElementById('bd-perc-val').textContent = totalPerc.toFixed(2);
        document.getElementById('bd-final-price').textContent = `$${gross.toLocaleString('es-AR', {minimumFractionDigits: 2, maximumFractionDigits: 2})}`;
    };

    const calculateNetFromGross = (gross) => {
        if (!gross || isNaN(gross)) return '';
        // Net = Gross - Fixed - (Gross * Percentage/100)
        const netValue = gross - totalFixed - (gross * (totalPerc / 100));
        updateVisualBreakdown(netValue, gross);
        return parseFloat(netValue).toFixed(2);
    };

    netInput?.addEventListener('input', (e) => {
        const val = parseFloat(e.target.value);
        if (!isNaN(val)) {
            baseInput.value = calculateGrossFromNet(val);
        } else {
            baseInput.value = '';
        }
    });

    baseInput?.addEventListener('input', (e) => {
        const val = parseFloat(e.target.value);
        if (!isNaN(val)) {
            netInput.value = calculateNetFromGross(val);
        } else {
            netInput.value = '';
        }
    });
    
    // Initial Calc
    if (baseInput && baseInput.value) {
        netInput.value = calculateNetFromGross(parseFloat(baseInput.value));
    } else {
        updateVisualBreakdown(0, 0);
    }
    
    // Fixed Costs Logic
    // We trigger a visual update initially to ensure JS dynamic tags render correctly
    updateVisualBreakdown(parseFloat(netInput.value) || 0, parseFloat(baseInput.value) || 0);
    
    document.querySelectorAll('.multiplier-btn').forEach(btn => {
        btn.addEventListener('click', (e) => {
            const multiplier = parseFloat(e.target.getAttribute('data-multiply'));
            if (!isNaN(multiplier) && netInput) {
                const manualInput = document.getElementById('manualMultiplier');
                if (manualInput) manualInput.value = multiplier;
                
                applyMultiplier(multiplier);
            }
        });
    });

    const manualMultInput = document.getElementById('manualMultiplier');
    manualMultInput?.addEventListener('input', (e) => {
        const val = parseFloat(e.target.value);
        if (!isNaN(val) && val > 0) {
            applyMultiplier(val);
        }
    });

    function applyMultiplier(multiplier) {
        if (!netInput) return;
        // Neto = Fijos * (Multiplicador - 1) 
        // This ensures (Neto + Fijos) = Fijos * Multiplicador
        const newNet = multiplier > 1 ? totalFixed * (multiplier - 1) : totalFixed * multiplier;
        netInput.value = newNet.toFixed(2);
        
        // Dispatch input event to auto-calculate basePrice
        netInput.dispatchEvent(new Event('input', { bubbles: true }));
        
        // Add a small visual pulse to the net input to show it updated
        netInput.parentElement.classList.add('ring-2', 'ring-emerald-400', 'ring-offset-1');
        setTimeout(() => {
            netInput.parentElement.classList.remove('ring-2', 'ring-emerald-400', 'ring-offset-1');
        }, 300);
    }

    // Toggle Breakdown
    const toggleBtn = document.getElementById('toggleBreakdown');
    const breakdownPanel = document.getElementById('pricingBreakdown');
    toggleBtn?.addEventListener('click', () => {
        breakdownPanel.classList.toggle('hidden');
        toggleBtn.classList.toggle('text-indigo-600');
        toggleBtn.classList.toggle('bg-indigo-50');
        toggleBtn.classList.toggle('rounded-md');
    });

    // Event Listeners Setup
    document.addEventListener('DOMContentLoaded', () => {
        const form = document.getElementById('product-form');
        if (form) {
            form.addEventListener('submit', handleSubmit);
        }

        // Delegate remove image events
        document.body.addEventListener('click', (e) => {
            const btn = e.target.closest('.remove-image-btn');
            if (btn) {
                const imageId = btn.getAttribute('data-image-id');
                const isNew = btn.getAttribute('data-is-new') === 'true';
                
                if (isNew) {
                    removeNewImage(imageId);
                } else {
                    removeExistingImage(imageId);
                }
            }

            // Remove existing variant image
            const variantRemoveBtn = e.target.closest('.remove-variant-existing-img');
            if (variantRemoveBtn) {
                const imgIdx = parseInt(variantRemoveBtn.getAttribute('data-img-idx'));
                const item = variantRemoveBtn.closest('.variant-item');
                const input = item.querySelector('input[name^="variant_existing_images_"]');
                
                if (input) {
                    const images = JSON.parse(input.value);
                    images.splice(imgIdx, 1);
                    input.value = JSON.stringify(images);
                    
                    // Remove UI element
                    variantRemoveBtn.closest('.relative').remove();
                    
                    // Update indices of remaining buttons in this variant
                    const container = item.querySelector('.variant-images-preview');
                    container.querySelectorAll('.remove-variant-existing-img').forEach((b, i) => {
                        b.setAttribute('data-img-idx', i);
                    });
                }
            }

            // Remove new variant image preview
            const newVariantRemoveBtn = e.target.closest('.remove-variant-new-img');
            if (newVariantRemoveBtn) {
                newVariantRemoveBtn.closest('.relative').remove();
            }
        });

        // --- ACCORDION LOGIC ---
        document.querySelectorAll('.accordion-toggle').forEach(toggle => {
            toggle.addEventListener('click', () => {
                const section = toggle.closest('.accordion-section');
                const content = section.querySelector('.accordion-content');
                const chevron = toggle.querySelector('.accordion-chevron');
                
                // Toggle state
                const isOpen = !content.classList.contains('hidden');
                
                if (isOpen) {
                    content.classList.add('hidden');
                    chevron.classList.remove('rotate-45');
                    section.classList.remove('active');
                } else {
                    content.classList.remove('hidden');
                    chevron.classList.add('rotate-45');
                    section.classList.add('active');
                    
                    // Smooth scroll to section header
                    section.scrollIntoView({ behavior: 'smooth', block: 'start' });
                }
            });
        });

        // Update pricing summary badge initially
        const updatePricingBadge = () => {
            const bp = document.getElementById('basePrice')?.value;
            const net = document.getElementById('netPrice')?.value;
            const badge = document.getElementById('pricing-summary-badge');
            if (badge && bp && net) {
                badge.innerHTML = `
                    <span class="px-2 py-0.5 rounded-full bg-emerald-100 text-emerald-600 text-[10px] font-black uppercase">PVP: $${bp}</span>
                    <span class="px-2 py-0.5 rounded-full bg-indigo-100 text-indigo-600 text-[10px] font-black uppercase">Neto: $${net}</span>
                `;
            }
        };
        setTimeout(updatePricingBadge, 500);

        // Sticky Save Bar Logic
        const stickyBar = document.getElementById('sticky-save-bar');
        const mainSaveBtn = document.querySelector('.save-btn');
        
        window.addEventListener('scroll', () => {
            if (!mainSaveBtn || !stickyBar) return;
            const rect = mainSaveBtn.getBoundingClientRect();
            if (rect.bottom < 0) {
                stickyBar.classList.remove('translate-y-32', 'translate-y-24');
                stickyBar.classList.add('translate-y-0');
            } else {
                stickyBar.classList.add('translate-y-32');
                stickyBar.classList.remove('translate-y-0');
            }
        });

        // Image Upload Preview
        const imageInput = document.getElementById('image');
        const newImagesContainer = document.getElementById('new-images-container');
        const dt = new DataTransfer();

        imageInput?.addEventListener('change', (e) => {
            const files = e.target.files;
            for (let i = 0; i < files.length; i++) {
                const file = files[i];
                dt.items.add(file);
                const reader = new FileReader();
                reader.readAsDataURL(file);
                reader.onloadend = () => {
                    const uniqueId = 'new-img-' + Date.now() + '-' + i;
                    const div = document.createElement('div');
                    div.className = 'relative group';
                    div.id = uniqueId;
                    div.innerHTML = `
