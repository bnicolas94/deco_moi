                                                                                    <input type="checkbox" name="supply_ids[]" value={child.id} data-cost={child.unitCost} data-name={child.name} class="supply-checkbox h-4 w-4 text-indigo-600 border-gray-300 rounded focus:ring-indigo-500" checked={isChildChecked} />
