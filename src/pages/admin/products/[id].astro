---
import AdminLayout from '@/layouts/AdminLayout.astro';
import { db } from '@/lib/db/connection';
import { products, categories, mockupTemplates, productionTimeRules, priceRules, meliItemLinks, costItems, productCostItems, productSupplies, supplies } from '@/lib/db/schema';
import { eq, asc, and } from 'drizzle-orm';
import { Save, ArrowLeft, Image as ImageIcon, Trash2, Star, Plus, Clock, ExternalLink } from 'lucide-react';
import RichTextEditor from '@/components/admin/RichTextEditor';

const { id } = Astro.params;
const isNew = id === 'new';

// Fetch initial data
let product: any = null;
let variants: any[] = [];
let timeRules: any[] = [];
let priceRulesList: any[] = [];
let meliLinkId = '';
let productCosts: any[] = [];
if (!isNew && id) {
    const result = await db.query.products.findFirst({
        where: eq(products.id, parseInt(id)),
        with: {
            variants: true
        }
    });
    product = result;
    variants = result?.variants || [];
    
    if (!product) {
        return Astro.redirect('/admin/products');
    }

    // Load production time rules
    timeRules = await db.select().from(productionTimeRules)
        .where(eq(productionTimeRules.productId, parseInt(id)))
        .orderBy(asc(productionTimeRules.minQuantity));

    // Load price rules
    priceRulesList = await db.select().from(priceRules)
        .where(eq(priceRules.productId, parseInt(id)))
        .orderBy(asc(priceRules.minQuantity));
        
    // Cargar link de MercadoLibre
    const mlLink = await db.select().from(meliItemLinks).where(eq(meliItemLinks.productId, parseInt(id))).limit(1);
    if(mlLink.length > 0) meliLinkId = mlLink[0].meliItemId;

    // Fetch product specific costs
    const pCosts = await db.select({
        name: costItems.name,
        type: costItems.type,
        value: costItems.value,
        isActive: costItems.isActive
    }).from(productCostItems).innerJoin(costItems, eq(productCostItems.costItemId, costItems.id))
    .where(eq(productCostItems.productId, parseInt(id)));
    
    productCosts = pCosts.filter(c => c.isActive).map(c => ({ name: c.name, type: c.type, value: Number(c.value) }));

    // Fetch product specific supplies
    const pSupplies = await db.select({
        quantity: productSupplies.quantity,
        partsUsed: productSupplies.partsUsed,
        partsTotal: productSupplies.partsTotal,
        unitCost: supplies.unitCost
    }).from(productSupplies).innerJoin(supplies, eq(productSupplies.supplyId, supplies.id))
    .where(eq(productSupplies.productId, parseInt(id)));

    const suppliesTotal = Math.round(pSupplies.reduce((acc, s) => {
        let qty = parseFloat(s.quantity.toString());
        if (s.partsUsed && s.partsTotal) {
            qty = parseFloat(s.partsUsed.toString()) / parseFloat(s.partsTotal.toString());
        }
        return acc + (qty * Number(s.unitCost));
    }, 0) * 100) / 100;

    if (suppliesTotal > 0) {
        // Merge with existing "Insumos" if present or push new
        const existingIdx = productCosts.findIndex(c => c.name.toLowerCase() === 'insumos');
        if (existingIdx !== -1) {
            productCosts[existingIdx].value += suppliesTotal;
        } else {
            productCosts.push({ name: 'Insumos', type: 'fixed', value: suppliesTotal });
        }
    }
}

// Global active costs
const gCosts = await db.select().from(costItems).where(
    and(eq(costItems.isActive, true), eq(costItems.isGlobal, true))
);

let allCosts = [...productCosts];
gCosts.forEach(gc => {
    if (!allCosts.some(p => p.name === gc.name)) {
        allCosts.push({ name: gc.name, type: gc.type, value: Number(gc.value) });
    }
});

const allCategories = await db.select().from(categories).orderBy(categories.name);
const allTemplates = await db.select().from(mockupTemplates).orderBy(mockupTemplates.name);

// Process images to identify cover (first one)
const currentImages = product?.images || [];

// --- COSTOS E INSUMOS ---
const allSupplies = await db.select().from(supplies).where(eq(supplies.isActive, true)).orderBy(supplies.name);
const parsedId = !isNew && id ? parseInt(id) : 0;

const linkedSuppliesData = isNew ? [] : await db.select({
    supplyId: productSupplies.supplyId,
    quantity: productSupplies.quantity,
    partsUsed: productSupplies.partsUsed,
    partsTotal: productSupplies.partsTotal,
}).from(productSupplies).where(eq(productSupplies.productId, parsedId));

const allCostItems = await db.select().from(costItems).where(eq(costItems.isActive, true)).orderBy(costItems.name);

const linkedCostItemIds = isNew ? [] : (await db.select({ id: productCostItems.costItemId })
    .from(productCostItems)
    .where(eq(productCostItems.productId, parsedId)))
    .map(r => r.id);

const rootSupplies = allSupplies.filter(s => !s.parentId || !allSupplies.some(p => p.id === s.parentId));
const suppliesByParent = new Map();
allSupplies.forEach(s => {
    if (s.parentId) {
        if (!suppliesByParent.has(s.parentId)) suppliesByParent.set(s.parentId, []);
        suppliesByParent.get(s.parentId).push(s);
    }
});

const supplyCategs = [...new Set(allSupplies.map(s => s.category))].sort();
const SUPPLY_ICONS: Record<string, string> = {
    'chocolates': '🍫', 'hojas': '📄', 'velas': '🕯️', 'cajas': '📦', 'extras': '✨', 'tejidos': '🧵', 'packaging': '📫', 'etiquetas': '🏷️'
};
// --- FIN COSTOS E INSUMOS ---
---

<AdminLayout title={isNew ? "Nuevo Producto" : `Editar: ${product?.name}`}>
    <form id="product-form" class="max-w-7xl mx-auto pb-20">
        <!-- Header -->
        <div class="mb-8 flex flex-col md:flex-row justify-between items-start md:items-center gap-4">
            <div class="flex items-center gap-4">
                <a 
                    href="/admin/products" 
                    class="p-2.5 bg-white border border-gray-100 text-gray-400 hover:text-gray-600 rounded-xl transition-all shadow-sm active:scale-95"
                >
                    <ArrowLeft className="w-5 h-5" />
                </a>
                <div>
                    <h1 class="text-3xl font-extrabold text-gray-900 tracking-tight">
                        {isNew ? "Nuevo Producto" : "Editar Producto"}
                    </h1>
                    <p class="text-gray-500 mt-1 font-medium italic">
                        {isNew ? "Añade un nuevo ítem a tu catálogo." : `Gestionando "${product?.name}"`}
                    </p>
                    {!isNew && product?.slug && (
                        <a 
                            href={`/producto/${product.slug}`} 
                            target="_blank"
                            class="inline-flex items-center gap-1.5 mt-2 px-3 py-1 text-xs font-bold text-indigo-600 bg-indigo-50 hover:bg-indigo-100 border border-indigo-100 rounded-full transition-all"
                        >
                            <ExternalLink className="w-3.5 h-3.5" />
                            Ver en tienda
                        </a>
                    )}
                </div>
            </div>
            
            <div class="flex items-center gap-3 w-full md:w-auto">
                {!isNew && (
                    <button 
                        type="button" 
                        onclick={`if(confirm('¿Seguro?')) fetch('/api/products/${id}', {method:'DELETE'}).then(()=>location.href='/admin/products')`}
                        class="flex-1 md:flex-none inline-flex items-center justify-center px-5 py-2.5 border-2 border-rose-50 text-rose-500 hover:bg-rose-50 font-bold rounded-xl transition-all"
                    >
                        <Trash2 className="w-5 h-5 mr-2" />
                        Eliminar
                    </button>
                )}
                <button 
                    type="submit" 
                    form="product-form"
                    class="save-btn flex-1 md:flex-none inline-flex items-center justify-center px-8 py-2.5 bg-gray-900 hover:bg-black text-white font-bold rounded-xl shadow-lg shadow-gray-200 transition-all transform active:scale-95 disabled:opacity-50 disabled:pointer-events-none"
                >
                    <div class="save-spinner hidden animate-spin w-4 h-4 border-2 border-white/30 border-t-white rounded-full mr-2"></div>
                    <Save className="w-5 h-5 mr-2 save-icon" />
                    <span class="save-text">Guardar Cambios</span>
                </button>
            </div>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8">
            <div class="lg:col-span-8 space-y-8">
                <!-- 1. General Information -->
                <div class="bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden accordion-section active" data-section="general">
                    <button type="button" class="w-full p-6 flex items-center justify-between hover:bg-gray-50/50 transition-colors accordion-toggle">
                        <div class="flex items-center gap-4">
                            <div class="w-10 h-10 rounded-xl bg-indigo-50 flex items-center justify-center text-indigo-600">
                                <span class="w-2.5 h-6 bg-indigo-500 rounded-full"></span>
                            </div>
                            <div class="text-left">
                                <h2 class="text-lg font-bold text-gray-900">Información General</h2>
                                <p class="text-xs text-gray-400 font-medium italic">Nombre, slug y descripciones detalladas</p>
                            </div>
                        </div>
                        <div class="flex items-center gap-3">
                            <span class="section-badge px-2 py-0.5 rounded-full bg-emerald-100 text-emerald-600 text-[10px] font-black uppercase opacity-0 transition-opacity">Completado</span>
                            <Plus className="w-5 h-5 text-gray-400 transition-transform duration-300 accordion-chevron rotate-45" />
                        </div>
                    </button>
                    <div class="accordion-content transition-all duration-300 ease-in-out">
                    <div class="p-6 space-y-6">
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                            <div class="space-y-2">
                                <label class="block text-sm font-bold text-gray-700">Nombre del Producto</label>
                                <input 
                                    type="text" 
                                    name="name" 
                                    id="name"
                                    value={product?.name} 
                                    required 
                                    placeholder="Ej: Vela Aromática de Lavanda"
                                    class="block w-full rounded-xl border-gray-200 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm h-11 border px-4 transition-all"
                                />
                            </div>
                            <div class="space-y-2">
                                <label class="block text-sm font-bold text-gray-700">Slug (URL)</label>
                                <input 
                                    type="text" 
                                    name="slug" 
                                    id="slug"
                                    value={product?.slug} 
                                    required 
                                    placeholder="vela-aromatica-lavanda"
                                    class="block w-full rounded-xl border-gray-200 bg-gray-50 text-gray-500 sm:text-sm h-11 border px-4"
                                />
                            </div>
                        </div>

                        <div class="space-y-2">
                            <label class="block text-sm font-bold text-gray-700">Descripción Corta</label>
                            <RichTextEditor 
                                client:only="react" 
                                name="shortDescription" 
                                initialValue={product?.shortDescription || ''} 
                                placeholder="Breve resumen para el catálogo..."
                                minHeight="450px"
                            />
                        </div>

                        <div class="space-y-2">
                            <label class="block text-sm font-bold text-gray-700">Descripción Detallada</label>
                            <RichTextEditor 
                                client:only="react" 
                                name="description" 
                                initialValue={product?.description || ''} 
                                placeholder="Escribe las características, beneficios y detalles del producto..."
                                minHeight="450px"
                            />
                        </div>
                    </div>
                </div>
            </div>

                <!-- 2. Pricing & Logistics -->
                <div class="bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden accordion-section" data-section="pricing">
                    <button type="button" class="w-full p-6 flex items-center justify-between hover:bg-gray-50/50 transition-colors accordion-toggle">
                        <div class="flex items-center gap-4">
                            <div class="w-10 h-10 rounded-xl bg-emerald-50 flex items-center justify-center text-emerald-600">
                                <span class="w-2.5 h-6 bg-emerald-500 rounded-full"></span>
                            </div>
                            <div class="text-left">
                                <h2 class="text-lg font-bold text-gray-900">Precios, Costos e Insumos</h2>
                                <p class="text-xs text-gray-400 font-medium italic">Cálculo de márgenes, insumos vinculados y transparencia</p>
                            </div>
                        </div>
                        <div class="flex items-center gap-3">
                            <div id="pricing-summary-badge" class="flex gap-1.5">
                                <span class="px-2 py-0.5 rounded-full bg-gray-100 text-gray-400 text-[10px] font-black uppercase">Calculando...</span>
                            </div>
                            <Plus className="w-5 h-5 text-gray-400 transition-transform duration-300 accordion-chevron" />
                        </div>
                    </button>
                    <div class="accordion-content hidden transition-all duration-300 ease-in-out">
                    <div class="p-6 space-y-6">
                        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
                            <div class="space-y-2 group lg:col-span-1">
                                <label class="block text-sm font-bold text-gray-700 group-focus-within:text-emerald-600 transition-colors">Precio Neto Sugerido</label>
                                <div class="relative">
                                    <span class="absolute left-3 top-1/2 -translate-y-1/2 text-gray-400 font-medium">$</span>
                                    <input 
                                        type="number" 
                                        step="0.01" 
                                        id="netPrice" 
                                        placeholder="0.00"
                                        class="block w-full pl-8 rounded-xl border-emerald-200 bg-emerald-50/30 shadow-sm focus:border-emerald-500 focus:ring-emerald-500 sm:text-sm h-11 border transition-all"
                                    />
                                </div>
                                <p class="text-[10px] text-gray-400 italic">Ganancia libre de costos y comisiones.</p>
                            </div>
                            <div class="space-y-2 group lg:col-span-1">
                                <div class="flex items-center justify-between">
                                    <label class="block text-sm font-bold text-gray-700 group-focus-within:text-indigo-600 transition-colors">Precio Base (Bruto)</label>
                                    <button type="button" id="toggleBreakdown" class="p-1 text-gray-400 hover:text-indigo-600 transition-colors" title="Ver Desglose de Cálculo">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-info"><circle cx="12" cy="12" r="10"/><path d="M12 16v-4"/><path d="M12 8h.01"/></svg>
                                    </button>
                                </div>
                                <div class="relative">
                                    <span class="absolute inset-y-0 left-0 pl-3.5 flex items-center text-gray-400 font-bold">$</span>
                                    <input 
                                        type="number" 
                                        step="0.01" 
                                        name="basePrice" 
                                        id="basePrice"
                                        value={product?.basePrice} 
                                        required 
                                        class="block w-full pl-8 rounded-xl border-gray-200 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm h-11 border transition-all"
                                    />
                                </div>
                                <p class="text-[10px] text-gray-400 italic mt-1">Precio final al público.</p>
                            </div>
                            <div class="space-y-2">
                                <label class="block text-sm font-bold text-gray-700">Inventario Inicial</label>
                                <input 
                                    type="number" 
                                    name="stock" 
                                    value={product?.stock} 
                                    required 
                                    class="block w-full rounded-xl border-gray-200 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm h-11 border px-4 transition-all"
                                />
                            </div>
                            <div class="space-y-2">
                                <label class="block text-sm font-bold text-gray-700">SKU</label>
                                <input 
                                    type="text" 
                                    name="sku" 
                                    value={product?.sku} 
                                    placeholder="PRD-001"
                                    class="block w-full rounded-xl border-gray-200 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm h-11 border px-4"
                                />
                            </div>
                        </div>

                        <!-- Pricing Breakdown Panel (Hidden by default) -->
                        <div id="pricingBreakdown" class="hidden animate-in fade-in slide-in-from-top-2 p-5 bg-indigo-50/50 border border-indigo-100 rounded-2xl space-y-4">
                            <div class="flex items-center justify-between border-b border-indigo-100/50 pb-2">
                                <h3 class="text-xs font-black text-indigo-900 uppercase tracking-wider flex items-center gap-2">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-microscope"><path d="M6 18h8"/><path d="M3 22h18"/><path d="M14 22a7 7 0 1 0 0-14h-1"/><path d="M9 14h2"/><path d="M9 12a2 2 0 0 1-2-2V6h6v4a2 2 0 0 1-2 2Z"/><path d="M12 6V3a1 1 0 0 0-1-1H9a1 1 0 0 0-1 1v3"/></svg>
                                    Desglose de Transparencia
                                </h3>
                                <span class="text-[10px] font-bold text-indigo-400">Fórmula: (Neto + Fijos) / (1 - %Fees)</span>
                            </div>
                            
                            <div class="grid grid-cols-1 md:grid-cols-2 gap-8 text-[11px]">
                                <!-- Fixed Costs List -->
                                <div class="space-y-2">
                                    <p class="font-bold text-gray-500 uppercase tracking-tight flex items-center justify-between">
                                        Costos Fijos 
                                        <span id="bd-total-fixed" class="text-rose-600">$0.00</span>
                                    </p>
                                    <div id="bd-fixed-list" class="space-y-1.5">
                                        <!-- Will be populated by JS -->
                                    </div>
                                </div>
                                
                                <!-- Percentage Fees List -->
                                <div class="space-y-2">
                                    <p class="font-bold text-gray-500 uppercase tracking-tight flex items-center justify-between">
                                        Comisiones y Gastos
                                        <span id="bd-total-perc" class="text-indigo-600">0%</span>
                                    </p>
                                    <div id="bd-perc-list" class="space-y-1.5">
                                        <!-- Will be populated by JS -->
                                    </div>
                                </div>
                            </div>

                            <!-- Final Summary -->
                            <div class="pt-3 border-t border-indigo-100/50 flex flex-wrap items-center gap-x-6 gap-y-2 text-xs">
                                <div class="flex items-center gap-1.5">
                                    <span class="text-gray-400 font-medium">Inversión Total:</span>
                                    <span id="bd-sum-investment" class="font-bold text-gray-900">$0.00</span>
                                    <span class="text-[10px] text-gray-400">(Neto + Fijos)</span>
                                </div>
                                <div class="flex items-center gap-1.5">
                                    <span class="text-gray-400 font-medium">Divisor:</span>
                                    <span id="bd-divisor" class="font-bold text-gray-900">0.00</span>
                                    <span class="text-[10px] text-gray-400">(1 - <span id="bd-perc-val">0</span>/100)</span>
                                </div>
                                <div class="ml-auto bg-indigo-600 text-white px-3 py-1.5 rounded-lg flex items-center gap-2">
                                    <span class="font-bold uppercase text-[9px] tracking-widest opacity-80">Precio Final:</span>
                                    <span id="bd-final-price" class="text-sm font-black">$0.00</span>
                                </div>
                            </div>
                        </div>

                        <!-- Dynamic Impact & Multiplier -->
                        <div id="product-calc-card" data-costs={JSON.stringify(allCostItems.filter(c => c.isGlobal || linkedCostItemIds.includes(c.id)))} class="sticky top-6 z-20 flex flex-col gap-3 p-4 bg-rose-50/95 backdrop-blur-md border border-rose-200 shadow-xl shadow-rose-900/5 rounded-xl mt-4 animate-in fade-in slide-in-from-top-1 transition-all">
                            <div class="flex flex-col sm:flex-row sm:items-start justify-between gap-4">
                                
                                <div class="flex flex-col gap-2 w-full flex-1">
                                    <!-- Header -->
                                    <div class="text-sm font-black text-rose-600 flex flex-wrap items-center gap-x-4 gap-y-1 border-b border-rose-100/50 pb-2">
                                        <div class="flex items-center gap-1.5">
                                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-calculator"><rect width="16" height="20" x="4" y="2" rx="2"/><line x1="8" x2="16" y1="6" y2="6"/><line x1="16" x2="16" y1="14" y2="18"/><path d="M16 10h.01"/><path d="M12 10h.01"/><path d="M8 10h.01"/><path d="M12 14h.01"/><path d="M8 14h.01"/><path d="M12 18h.01"/><path d="M8 18h.01"/></svg>
                                            <span>Costos Totales del Producto: <span id="calc-costs">$ 0.00</span></span>
                                        </div>
                                        <div class="flex items-center gap-1.5 text-indigo-700 ml-auto mr-4">
                                            <span>Margen Bruto: <span id="calc-margin">$ 0.00</span></span>
                                            <span class="text-xs bg-indigo-100 px-1.5 py-0.5 rounded" id="calc-percent">0%</span>
                                        </div>
                                    </div>
                                    
                                    <!-- Breakdowns -->
                                    <div class="flex flex-col gap-2 mt-1">
                                        <!-- Insumos Row -->
                                        <div class="flex items-start gap-2">
                                            <span class="text-[10px] font-bold text-rose-400 uppercase tracking-wider w-16 mt-0.5">Insumos:</span>
                                            <div class="flex flex-wrap gap-1.5 flex-1" id="top-insumos-list">
                                                <!-- Populated by JS -->
                                            </div>
                                        </div>

                                        <!-- Comisiones/Variables Row -->
                                        <div class="flex items-start gap-2">
                                            <span class="text-[10px] font-bold text-rose-400 uppercase tracking-wider w-16 mt-0.5">Globales:</span>
                                            <div class="flex flex-wrap gap-1.5 flex-1" id="top-global-costs-list">
                                                <!-- Populated by JS -->
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <!-- Multiplier -->
                                <div class="flex flex-col items-start gap-1 sm:items-end w-full sm:w-auto mt-2 sm:mt-0 pt-3 sm:pt-0 border-t border-rose-100/50 sm:border-0 pl-0 sm:pl-3">
                                    <span class="text-[10px] text-rose-400 font-bold uppercase tracking-widest hidden sm:inline-block">Multiplicador Fijo</span>
                                    <div class="flex items-center bg-white border border-rose-100 rounded-lg p-0.5 shadow-sm">
                                        <button type="button" class="multiplier-btn px-2.5 py-1 hover:bg-rose-50 text-rose-600 font-bold text-xs rounded-md transition-all active:scale-95" data-multiply="2">x2</button>
                                        <button type="button" class="multiplier-btn px-2.5 py-1 hover:bg-rose-50 text-rose-600 font-bold text-xs rounded-md transition-all active:scale-95" data-multiply="3">x3</button>
                                        <button type="button" class="multiplier-btn px-2.5 py-1 hover:bg-rose-50 text-rose-600 font-bold text-xs rounded-md transition-all active:scale-95" data-multiply="4">x4</button>
                                        <div class="w-px h-4 bg-rose-100 mx-1"></div>
                                        <div class="relative flex items-center">
                                            <span class="absolute left-1.5 text-[10px] font-bold text-rose-400">x</span>
                                            <input 
                                                type="number" 
                                                step="0.1" 
                                                id="manualMultiplier" 
                                                placeholder="Pers." 
                                                class="w-14 pl-3.5 pr-1 py-1 text-[10px] font-bold text-rose-600 border-none focus:ring-0 placeholder:text-rose-300"
                                            />
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

<!-- Parte 2: Insumos Utilizados -->
                                <div class="space-y-4">
                                    <h3 class="text-sm font-bold text-gray-900 border-b border-gray-100 pb-2">Insumos Utilizados</h3>
                                    
                                    <div class="flex flex-wrap gap-2 mb-4" id="supply-category-tabs">
                                        <button type="button" class="supply-tab-btn px-4 py-2 rounded-full text-xs font-bold transition-all border bg-indigo-600 text-white border-indigo-600 shadow-sm flex items-center gap-2" data-category="ALL">
