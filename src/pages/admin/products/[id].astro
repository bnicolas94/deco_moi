                                                                                    <button type="button" class={`yield-toggle p-1.5 hover:text-indigo-600 hover:bg-indigo-50 rounded-lg transition-all ${hasChildYield ? 'text-indigo-600 bg-indigo-50' : 'text-gray-400'}`} title="Calculadora de Rinde" data-id={child.id}>
