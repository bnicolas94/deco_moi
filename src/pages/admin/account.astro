---
import AdminLayout from '@/layouts/AdminLayout.astro';

const status = Astro.url.searchParams.get('status');
const error = Astro.url.searchParams.get('error');

const errorMessages: Record<string, string> = {
    invalid_current: 'La contraseña actual no es correcta.',
    mismatch: 'Las contraseñas nuevas no coinciden.',
    too_short: 'La contraseña nueva debe tener al menos 12 caracteres.',
    too_long: 'La contraseña nueva no puede superar los 128 caracteres.',
    same_password: 'La contraseña nueva debe ser diferente de la actual.',
    invalid_request: 'No se pudo validar la solicitud. Recargá la página e intentá nuevamente.',
    unavailable: 'No se pudo cambiar la contraseña. Intentá nuevamente más tarde.',
};
---

<AdminLayout title="Mi cuenta">
    <div class="max-w-2xl mx-auto">
        <div class="mb-6">
            <h1 class="text-2xl font-bold text-gray-900">Mi cuenta</h1>
            <p class="text-gray-500 mt-1">Actualizá la contraseña de acceso al administrador.</p>
        </div>

        {status === 'password_changed' && (
            <div role="status" class="mb-6 rounded-lg border border-emerald-200 bg-emerald-50 px-4 py-3 text-emerald-800">
                La contraseña se cambió correctamente. Esta sesión sigue abierta y las demás sesiones fueron cerradas.
            </div>
        )}

        {error && (
            <div role="alert" class="mb-6 rounded-lg border border-red-200 bg-red-50 px-4 py-3 text-red-800">
                {errorMessages[error] || errorMessages.unavailable}
            </div>
        )}

        <form action="/api/admin/change-password" method="POST" class="bg-white rounded-lg border border-gray-100 shadow-sm p-6 space-y-5">
            <div>
                <label for="currentPassword" class="block text-sm font-medium text-gray-700 mb-1">Contraseña actual</label>
                <input
                    id="currentPassword"
                    name="currentPassword"
                    type="password"
                    autocomplete="current-password"
                    required
                    maxlength="128"
                    class="block w-full rounded-md border border-gray-300 px-3 py-2 shadow-sm focus:border-indigo-500 focus:ring-indigo-500"
                />
            </div>

            <div>
                <label for="newPassword" class="block text-sm font-medium text-gray-700 mb-1">Contraseña nueva</label>
                <input
                    id="newPassword"
                    name="newPassword"
                    type="password"
                    autocomplete="new-password"
                    required
                    minlength="12"
                    maxlength="128"
                    aria-describedby="password-help"
                    class="block w-full rounded-md border border-gray-300 px-3 py-2 shadow-sm focus:border-indigo-500 focus:ring-indigo-500"
                />
                <p id="password-help" class="mt-1 text-sm text-gray-500">Usá al menos 12 caracteres y una contraseña única.</p>
            </div>

            <div>
                <label for="confirmPassword" class="block text-sm font-medium text-gray-700 mb-1">Confirmar contraseña nueva</label>
                <input
                    id="confirmPassword"
                    name="confirmPassword"
                    type="password"
                    autocomplete="new-password"
                    required
                    minlength="12"
                    maxlength="128"
                    class="block w-full rounded-md border border-gray-300 px-3 py-2 shadow-sm focus:border-indigo-500 focus:ring-indigo-500"
                />
            </div>

            <div class="rounded-lg bg-amber-50 border border-amber-200 px-4 py-3 text-sm text-amber-800">
                Al guardar se cerrarán las demás sesiones administrativas. Esta sesión permanecerá activa.
            </div>

            <div class="flex justify-end">
                <button type="submit" class="inline-flex items-center rounded-md bg-indigo-600 px-4 py-2 text-sm font-medium text-white shadow-sm hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2">
                    Cambiar contraseña
                </button>
            </div>
        </form>
    </div>
</AdminLayout>
