---
import { sanitizeCssColor, sanitizePublicUrl } from '@/lib/security/html';

export interface Testimonial {
    name: string;
    role?: string;
    content: string;
    image?: string;
    rating?: number;
}

export interface Props {
    title?: string;
    subtitle?: string;
    testimonials?: Testimonial[];
    backgroundColor?: string;
}

const {
    title = 'Lo que dicen nuestros clientes',
    subtitle,
    testimonials = [],
    backgroundColor = '#ffffff'
} = Astro.props;
const safeBackgroundColor = sanitizeCssColor(backgroundColor, '#ffffff');
---

<section class="py-16 md:py-24" style={`background-color: ${safeBackgroundColor};`}>
    <div class="container mx-auto px-4">
        <div class="text-center max-w-3xl mx-auto mb-16">
            <h2 class="text-3xl md:text-4xl font-bold text-gray-900 mb-4 font-montserrat">{title}</h2>
            {subtitle && <p class="text-lg text-gray-600">{subtitle}</p>}
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
            {testimonials.map((t) => (
                <div class="bg-gray-50 p-8 rounded-2xl border border-gray-100 flex flex-col h-full relative">
                    <svg class="absolute top-6 left-6 w-8 h-8 text-gray-200" fill="currentColor" viewBox="0 0 24 24">
                        <path d="M14.017 21v-7.391c0-5.704 3.731-9.57 8.983-10.609l.995 2.151c-2.432.917-3.995 3.638-3.995 5.849h4v10h-9.983zm-14.017 0v-7.391c0-5.704 3.748-9.57 9-10.609l.996 2.151c-2.433.917-3.996 3.638-3.996 5.849h3.983v10h-9.983z" />
                    </svg>
                    
                    <div class="flex-1 mt-4 mb-8 z-10 relative">
                        {t.rating && (
                            <div class="flex gap-1 mb-4 text-yellow-400">
                                {Array.from({ length: 5 }).map((_, i) => (
                                    <svg class={`w-5 h-5 ${i < t.rating! ? 'fill-current' : 'text-gray-300'}`} viewBox="0 0 20 20">
                                        <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                                    </svg>
                                ))}
                            </div>
                        )}
                        <p class="text-gray-700 leading-relaxed italic">{t.content}</p>
                    </div>

                    <div class="flex items-center gap-4 mt-auto">
                        <div class="w-12 h-12 rounded-full overflow-hidden bg-gray-200 shrink-0">
                            {t.image ? (
                                <img src={sanitizePublicUrl(t.image)} alt={t.name} class="w-full h-full object-cover" loading="lazy" />
                            ) : (
                                <div class="w-full h-full flex items-center justify-center bg-brand-primary text-white font-bold text-lg">
                                    {t.name.charAt(0)}
                                </div>
                            )}
                        </div>
                        <div>
                            <h4 class="font-bold text-gray-900">{t.name}</h4>
                            {t.role && <p class="text-sm text-gray-500">{t.role}</p>}
                        </div>
                    </div>
                </div>
            ))}
            
            {testimonials.length === 0 && (
                <div class="col-span-full text-center text-gray-400 py-10 border-2 border-dashed border-gray-200 rounded-xl">
                    Agrega testimonios desde las propiedades del bloque.
                </div>
            )}
        </div>
    </div>
</section>
