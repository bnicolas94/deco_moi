---
import { clampNumber, sanitizeCssColor } from '@/lib/security/html';

export interface Props {
    height?: number;
    showLine?: boolean;
    lineColor?: string;
}

const {
    height = 50,
    showLine = false,
    lineColor = '#EBE5DB'
} = Astro.props;
const safeHeight = clampNumber(height, 50, 0, 1_000);
const safeLineColor = sanitizeCssColor(lineColor, '#EBE5DB');
---

<div style={`height: ${safeHeight}px;`} class="w-full flex items-center justify-center bg-white" aria-hidden="true">
    {showLine && (
        <div class="w-3/4 max-w-6xl mx-auto border-t" style={`border-color: ${safeLineColor};`}></div>
    )}
</div>
