---
import { db } from '@/lib/db/connection';
import { products, categories } from '@/lib/db/schema';
import { and, eq, desc, inArray } from 'drizzle-orm';
import ProductCard from '../product/ProductCard.astro';
import { clampNumber, sanitizePublicUrl } from '@/lib/security/html';

export interface Props {
    title?: string;
    subtitle?: string;
    categoryIds?: number[];
    limit?: number;
    showCta?: boolean;
    ctaText?: string;
    ctaLink?: string;
}

const {
    title = 'Nuestros Productos',
    subtitle,
    categoryIds = [],
    limit = 4,
    showCta = false,
    ctaText = 'Ver todos',
    ctaLink = '/productos'
} = Astro.props;
const safeCtaLink = sanitizePublicUrl(ctaLink, '/productos');
const safeLimit = Math.round(clampNumber(limit, 4, 1, 24));

const conditions = [eq(products.isActive, true)];
if (categoryIds.length > 0) {
    conditions.push(inArray(products.categoryId, categoryIds));
}

// Fetch products based on criteria
const fetchedProducts = await db.select({
    id: products.id,
    name: products.name,
    slug: products.slug,
    description: products.description,
    shortDescription: products.shortDescription,
    basePrice: products.basePrice,
    salePrice: products.salePrice,
    isOnSale: products.isOnSale,
    isFeatured: products.isFeatured,
    minOrder: products.minOrder,
    stock: products.stock,
    sku: products.sku,
    images: products.images,
    isActive: products.isActive,
    categoryId: products.categoryId,
    createdAt: products.createdAt,
    categoryName: categories.name,
    categorySlug: categories.slug
})
.from(products)
.leftJoin(categories, eq(products.categoryId, categories.id))
.where(and(...conditions))
.orderBy(desc(products.createdAt))
.limit(safeLimit);
---

<section class="py-16 md:py-24 bg-white">
    <div class="container mx-auto px-4">
        <div class="flex flex-col md:flex-row justify-between items-end mb-12 gap-4">
            <div class="max-w-2xl">
                <h2 class="text-3xl md:text-4xl font-bold text-gray-900 mb-4 font-montserrat">{title}</h2>
                {subtitle && <p class="text-lg text-gray-600">{subtitle}</p>}
            </div>
            {showCta && safeCtaLink && (
                <a href={safeCtaLink} class="text-brand-primary font-medium hover:underline flex items-center gap-1">
                    {ctaText} <span aria-hidden="true">&rarr;</span>
                </a>
            )}
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
            {fetchedProducts.map((product) => (
                <ProductCard product={product as any} />
            ))}
        </div>

        {fetchedProducts.length === 0 && (
            <div class="text-center text-gray-400 py-20 border-2 border-dashed border-gray-200 rounded-xl">
                No hay productos disponibles para mostrar con los filtros actuales.
            </div>
        )}
    </div>
</section>
