---
import { sanitizeCssColor, sanitizePublicUrl } from '@/lib/security/html';

interface OccasionCard {
  id?: string;
  title?: string;
  description?: string;
  image?: string;
  link?: string;
  buttonText?: string;
  newTab?: boolean;
  isActive?: boolean;
}

interface LegacyCategory {
  name?: string;
  slug?: string;
  description?: string;
  image?: string;
}

interface Props {
  title?: string;
  subtitle?: string;
  backgroundColor?: string;
  buttonText?: string;
  buttonLink?: string;
  cards?: OccasionCard[];
  categories?: LegacyCategory[];
}

const defaultCards: OccasionCard[] = [
  { id: 'cumpleanos', title: 'Cumpleaños', description: 'Detalles personalizados para sorprender.', image: '/images/home/occasion-cumpleanos.webp', link: '/productos', buttonText: 'Ver regalos', isActive: true },
  { id: 'eventos', title: 'Eventos especiales', description: 'Souvenirs para celebrar momentos únicos.', image: '/images/home/occasion-eventos.webp', link: '/productos', buttonText: 'Descubrir', isActive: true },
  { id: 'intencion', title: 'Regalos con intención', description: 'Para agradecer, acompañar o decir “te quiero”.', image: '/images/home/occasion-regalos.webp', link: '/productos', buttonText: 'Encontrar el ideal', isActive: true },
  { id: 'empresas', title: 'Pedidos empresariales', description: 'Regalos personalizados para equipos y clientes.', image: '/images/home/occasion-empresas.webp', link: '/contacto', buttonText: 'Consultar', isActive: true },
];

// Reemplaza automáticamente las fotos iniciales aunque ya hayan quedado guardadas en la configuración.
const upgradedDefaultImages: Record<string, string> = {
  '/uploads/products/20250403_111821-scaled-e1756843398571.jpg': '/images/home/occasion-cumpleanos.webp',
  '/uploads/products/AirBrush_20220518162032.jpg': '/images/home/occasion-eventos.webp',
  '/uploads/products/AirBrush_20251018125838.jpg': '/images/home/occasion-regalos.webp',
  '/uploads/products/AirBrush_20251106202441-scaled.jpg': '/images/home/occasion-empresas.webp',
};

const {
  title = 'Un detalle para cada momento',
  subtitle = 'Elegí la ocasión y encontrá un regalo hecho para emocionar.',
  backgroundColor = '#ffffff',
  buttonText = 'Ver regalos disponibles',
  buttonLink = '/productos',
  cards,
  categories,
} = Astro.props;

// Los datos antiguos de categorías siguen funcionando hasta que se guarde el bloque nuevo.
const sourceCards: OccasionCard[] = Array.isArray(cards)
  ? cards
  : categories?.length
    ? categories.map((category) => ({
        title: category.name,
        description: category.description,
        image: category.image,
        link: `/productos/${category.slug || ''}`,
        buttonText: 'Ver opciones',
        isActive: true,
      }))
    : defaultCards;

const visibleCards = sourceCards
  .slice(0, 6)
  .filter((card) => card.isActive !== false && card.title?.trim())
  .map((card, index) => ({
    ...card,
    title: card.title!.trim().slice(0, 100),
    description: card.description?.trim().slice(0, 220) || '',
    image: sanitizePublicUrl(upgradedDefaultImages[card.image || ''] || card.image),
    link: sanitizePublicUrl(card.link, '/productos'),
    buttonText: card.buttonText?.trim().slice(0, 60) || 'Ver opciones',
    newTab: card.newTab === true,
    accent: ['#E8C4A6', '#E0BFB8', '#C9A980', '#D9CDBD', '#E6D7C4', '#D8C4B6'][index % 6],
  }));

const safeBackground = sanitizeCssColor(backgroundColor, '#ffffff');
const safeButtonLink = sanitizePublicUrl(buttonLink, '/productos');
---

{visibleCards.length > 0 && (
  <section class="section overflow-hidden" style={`background-color: ${safeBackground}`} aria-labelledby="occasions-title">
    <div class="container">
      <div class="text-center mb-10 md:mb-12">
        <p class="text-[11px] font-semibold uppercase tracking-[0.28em] text-secondary mb-3">Regalos con intención</p>
        <h2 id="occasions-title" class="section-title !mb-0">{title}</h2>
        <div class="gold-line mt-4 mb-4"></div>
        {subtitle && <p class="section-subtitle !mb-0">{subtitle}</p>}
      </div>

      <div class="occasion-scroll -mx-4 px-4 sm:mx-0 sm:px-0" aria-label="Ocasiones de compra">
        {visibleCards.map((card, index) => (
          <a
            href={card.link}
            target={card.newTab ? '_blank' : undefined}
            rel={card.newTab ? 'noopener noreferrer' : undefined}
            class="occasion-card group"
            aria-label={`${card.title}: ${card.buttonText}`}
          >
            <div class="absolute inset-0" style={`background: linear-gradient(145deg, ${card.accent} 0%, #F7F0E9 100%)`}>
              {card.image ? (
                <img src={card.image} alt="" width="800" height="1000" loading="lazy" decoding="async" class="h-full w-full object-cover" />
              ) : (
                <div class="h-full w-full flex items-start justify-end p-5" aria-hidden="true">
                  <span class="font-heading text-[5.5rem] leading-none text-white/35 italic">{String(index + 1).padStart(2, '0')}</span>
                </div>
              )}
            </div>
            <div class="absolute inset-0 bg-gradient-to-t from-brand-black/80 via-brand-black/10 to-transparent"></div>
            <div class="absolute inset-x-0 bottom-0 z-10 p-5 md:p-6">
              <h3 class="font-heading text-2xl font-bold text-white leading-tight mb-1.5">{card.title}</h3>
              {card.description && <p class="text-sm leading-relaxed text-white/80 line-clamp-2">{card.description}</p>}
              <span class="mt-4 inline-flex items-center gap-2 text-xs font-semibold uppercase tracking-[0.12em] text-white">
                {card.buttonText}
                <svg class="h-4 w-4 transition-transform duration-300 group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M5 12h14m-5-5 5 5-5 5" />
                </svg>
              </span>
            </div>
          </a>
        ))}
      </div>

      {buttonText && (
        <div class="mt-9 text-center">
          <a href={safeButtonLink} class="btn btn-primary btn-lg">{buttonText}</a>
        </div>
      )}
    </div>
  </section>
)}

<style>
  .occasion-scroll {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: minmax(78vw, 1fr);
    gap: 1rem;
    overflow-x: auto;
    overscroll-behavior-inline: contain;
    scroll-snap-type: inline mandatory;
    scrollbar-width: none;
  }

  .occasion-scroll::-webkit-scrollbar { display: none; }

  .occasion-card {
    position: relative;
    display: block;
    min-height: 21rem;
    overflow: hidden;
    border-radius: 1.25rem;
    scroll-snap-align: center;
    box-shadow: 0 12px 35px rgba(44, 44, 44, 0.10);
    transition: transform .35s ease, box-shadow .35s ease;
  }

  .occasion-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 20px 44px rgba(44, 44, 44, 0.16);
  }

  @media (min-width: 640px) {
    .occasion-scroll {
      grid-auto-flow: row;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      overflow: visible;
    }
  }

  @media (min-width: 1024px) {
    .occasion-scroll { grid-template-columns: repeat(4, minmax(0, 1fr)); }
    .occasion-card { min-height: 22rem; }
  }
</style>
